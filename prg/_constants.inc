; OAM ENTRIES, FOR GREAT ORGANIZATION
MAX_METASPRITES = 16
METASPRITE_OAM_COUNT = MAX_METASPRITES * 2
MAX_ACTIVE_COINS = 12
FIRST_COIN_SPRITE = METASPRITE_OAM_COUNT
PAUSE_INDICATOR_OAM_INDEX = FIRST_COIN_SPRITE ; NOTE: SHOULD OVERLAP COIN DRAWING AREA
FIRST_INDICATOR_OAM_INDEX = FIRST_COIN_SPRITE+MAX_ACTIVE_COINS
SECOND_INDICATOR_OAM_INDEX = FIRST_INDICATOR_OAM_INDEX+3
BANNER_FIRST_OAM_INDEX = SECOND_INDICATOR_OAM_INDEX+3
BOMB_COUNT_FIRST_OAM_INDEX = BANNER_FIRST_OAM_INDEX+4
MAX_DISPLAYED_PARTICLES = 8 ;  must be a power of 2!
PARTICLE_FIRST_OAM_INDEX = BOMB_COUNT_FIRST_OAM_INDEX+2
.assert (PARTICLE_FIRST_OAM_INDEX + MAX_DISPLAYED_PARTICLES <= 64), error, "oam index overflow"

