; ======================================================================
;                         Layouts and Widgets
; ======================================================================

.segment "DATA_UI_LAYOUTS"

name_entry_ui_layout:
        widget_controller FAR_name_entry_controller_init
        widget_text_label name_entry_str, 11, 3
        widget_string_entry english_page_table, (current_save + SaveFile::PlayerName)
        .addr $0000 ; end of list

name_entry_str:   .asciiz "NAME ENTRY"

english_upper_str: .asciiz "UPPER"
letter_grid_english_upper:
        .byte 'A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'
        .byte 'I', 'J', 'K', 'L', 'M', 'N', 'O', 'P'
        .byte 'Q', 'R', 'S', 'T', 'U', 'V', 'W', 'X'
        .byte 'Y', 'Z', ' ', '0', '1', '2', '3', '4'
        .byte '.', ',', '-', '5', '6', '7', '8', '9'
        .byte '+', '_', '/', '^', '&', '*', '(', ')'

english_lower_str: .asciiz "lower"
letter_grid_english_lower:
        .byte 'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'
        .byte 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p'
        .byte 'q', 'r', 's', 't', 'u', 'v', 'w', 'x'
        .byte 'y', 'z', '?', '!', '@', '#', '$', '%'
        .byte '`', '~', '*', '=', '\', '|', '[', ']'
        .byte '<', '>', '{', '}', $3B, ':', $22, $27

english_page_table:
        .addr english_upper_str, letter_grid_english_upper
        .addr english_lower_str, letter_grid_english_lower
        .addr $0000

; TODO: give this its own separate palette data
name_entry_pal_default_base:    .incbin "../art/palettes/options/base.pal"
name_entry_pal_sprite:          .incbin "../art/options_sprite_palette.pal"

name_entry_bg_palette_table:
        .addr name_entry_pal_default_base, name_entry_pal_default_base, name_entry_pal_default_base, name_entry_pal_default_base, name_entry_pal_default_base
name_entry_obj_palette_table:
        .addr name_entry_pal_sprite, name_entry_pal_sprite, name_entry_pal_sprite, name_entry_pal_sprite, name_entry_pal_sprite

.segment "CODE_UI_LAYOUTS"

.proc FAR_name_entry_controller_init
Top := R0
Left := R1
Width := R2
Height := R3

; Used when setting up palettes
PaletteTablePtr  := R4
PaletteTableBank := R6

CurrentWidgetIndex := R20
        perform_zpcm_inc

        ; Play the ... I dunno, the OPTIONS track on the name entry screen, for now.
        ; TODO: a file select theme? or we just use options for this whole set
        lda #TRACK_OPTIONS
        ldy #TRACK_VARIANT_NORMAL
        jsr play_track

        ; this screen DOES use extended attributes, so set that up
        lda #0
        sta LeftNametableBank
        sta RightNametableBank
        lda #(NT_FPGA_RAM | NT_EXT_BANK_2 | NT_EXT_BG_AT)
        sta LeftNametableAttr
        sta RightNametableAttr

        ; draw an initial checkerboard background (no nametable for now)
        near_call FAR_draw_checkerboard_base
        ; Draw a big ol' box to house the name picker
        lda #3
        sta Left
        lda #6
        sta Top
        lda #25
        sta Width
        lda #20
        sta Height
        far_call widget_file_select_box::FAR_draw_box_outline_light
        far_call widget_file_select_box::FAR_draw_box_fill
        far_call widget_file_select_box::FAR_draw_box_shadow
        ; And a smaller box up top for the title / instruction
        lda #8
        sta Left
        lda #2
        sta Top
        lda #15
        sta Width
        lda #3
        sta Height
        far_call widget_file_select_box::FAR_draw_box_outline_light
        far_call widget_file_select_box::FAR_draw_box_fill
        far_call widget_file_select_box::FAR_draw_box_shadow

        st16 PaletteTablePtr, name_entry_bg_palette_table
        st16 PaletteTableBank, .bank(name_entry_bg_palette_table)
        far_call FAR_load_palette_by_colorspace
        far_call FAR_set_bg_target_palette_from_hw
        far_call FAR_set_bg_current_palette_from_target

        st16 PaletteTablePtr, name_entry_obj_palette_table
        st16 PaletteTableBank, .bank(name_entry_obj_palette_table)
        far_call FAR_load_palette_by_colorspace
        far_call FAR_set_obj_palette_from_hw

        lda #BRIGHTNESS_FULLY_DARK
        jsr set_brightness
        lda #BRIGHTNESS_NORMAL
        sta TargetBrightness

        ldy CurrentWidgetIndex
        set_widget_state_y FAR_name_entry_controller_update
        rts
.endproc

.proc FAR_name_entry_controller_update
        perform_zpcm_inc
        far_call FAR_draw_sprites

        rts
.endproc
