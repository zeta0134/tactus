; ======================================================================
;                         Layouts and Widgets
; ======================================================================

name_entry_ui_layout:
        widget_controller name_entry_controller_init
        widget_cursor
        widget_text_button name_entry_str, widget_no_behavior, 12, 10        
        .addr $0000 ; end of list

name_entry_str:   .asciiz "NAME ENTRY (WIP)"

.proc name_entry_controller_init
CurrentWidgetIndex := R20
        perform_zpcm_inc

        ; Play the ... I dunno, the OPTIONS track on the name entry screen, for now.
        ; TODO: a file select theme? or we just use options for this whole set
        lda #TRACK_OPTIONS
        ldy #TRACK_VARIANT_NORMAL
        jsr play_track

        ; this screen DOES use extended attributes, so set that up
        lda #0
        sta LeftNametableBank
        sta RightNametableBank
        lda #(NT_FPGA_RAM | NT_EXT_BANK_2 | NT_EXT_BG_AT)
        sta LeftNametableAttr
        sta RightNametableAttr

        ; Get the file select palettes loaded in
        ldy #0
bg_loop:
        perform_zpcm_inc
        ; TODO: use file select palette here!
        lda options_battlefield_bg_palette, y
        sta BgPaletteBuffer, y
        lda options_obj_palette, y
        sta ObjPaletteBuffer, y
        iny
        cpy #16
        bne bg_loop

        ; TODO: initial drawing, etc

        ldy CurrentWidgetIndex
        set_widget_state_y name_entry_controller_update
        rts
.endproc

.proc name_entry_controller_update
        rts
.endproc
