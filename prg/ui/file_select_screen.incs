; ======================================================================
;                         Layouts and Widgets
; ======================================================================

file_select_ui_layout:
        widget_controller file_select_controller_init
        widget_cursor
        widget_text_label file_select_str, 8, 2
        widget_file_select_box 0, 5, 4
        widget_file_select_box 1, 5, 10
        widget_file_select_box 2, 5, 16
        widget_text_button erase_file_str, widget_no_behavior, 8, 22
        widget_text_button copy_file_str, widget_no_behavior, 8, 23
        .addr $0000 ; end of list

file_select_str:   .asciiz "FILE SELECT"
erase_file_str: .asciiz "ERASE FILE"
copy_file_str: .asciiz "COPY FILE"

DARK_SQUARE_TILE = $06
LIGHT_SQUARE_TILE = $07

.proc draw_checkerboard_base
NametableAddr := R0
AttributeAddr := R2
CheckTracker := R4
RowCounter := R5
        st16 NametableAddr, $5000
        st16 AttributeAddr, $5800
        ldy #0
        sty CheckTracker
        sty RowCounter
row_loop:
        lda CheckTracker
        eor #1
        sta CheckTracker
col_loop:
        lda CheckTracker
        eor #1
        sta CheckTracker
        beq dark_square
light_square:
        lda #LIGHT_SQUARE_TILE
        jmp tile_converge
dark_square:
        lda #DARK_SQUARE_TILE
tile_converge:
        sta (NametableAddr), y
        lda #(CHR_BANK_FONT_MARSHMALLOW | UI_PAL_BG0)
        sta (AttributeAddr), y
        iny
        cpy #32
        bne col_loop
        ldy #0
        add16b NametableAddr, #32
        add16b AttributeAddr, #32
        inc RowCounter
        lda RowCounter
        cmp #30
        bne row_loop
        rts
.endproc

.proc file_select_controller_init
CurrentWidgetIndex := R20

        perform_zpcm_inc
        ; Play the ... I dunno, the OPTIONS track on the file select screen, for now.
        ; TODO: a file select theme? or we just use options for this whole set
        lda #TRACK_OPTIONS
        ldy #TRACK_VARIANT_NORMAL
        jsr play_track

        ; the options screen DOES use extended attributes, so set that up
        lda #0
        sta LeftNametableBank
        sta RightNametableBank
        lda #(NT_FPGA_RAM | NT_EXT_BANK_2 | NT_EXT_BG_AT)
        sta LeftNametableAttr
        sta RightNametableAttr

        ; draw an initial checkerboard background (no nametable for now)
        jsr draw_checkerboard_base

        ; Get the file select palettes loaded in
        ldy #0
bg_loop:
        perform_zpcm_inc
        ; TODO: use file select palette here!
        lda options_battlefield_bg_palette, y
        sta BgPaletteBuffer, y
        lda options_obj_palette, y
        sta ObjPaletteBuffer, y
        iny
        cpy #16
        bne bg_loop


        ldy CurrentWidgetIndex
        set_widget_state_y file_select_controller_update
        rts
.endproc

.proc file_select_controller_update
        lda #KEY_B
        and ButtonsDown
        beq stay_here
        jsr return_to_title
        rts
stay_here:
        rts
.endproc