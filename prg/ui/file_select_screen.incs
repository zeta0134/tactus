; ======================================================================
;                         Layouts and Widgets
; ======================================================================

.segment "DATA_UI_LAYOUTS"

file_select_ui_layout:
        widget_controller FAR_file_select_controller_init
        widget_cursor
        widget_text_label file_select_str, 10, 3
        widget_file_select_box 0, 4, 6
        widget_file_select_box 1, 4, 11
        widget_file_select_box 2, 4, 16
        widget_text_button erase_file_str, FAR_play_sfx_and_enter_erase_mode, 10, 22
        widget_text_button copy_file_str, FAR_play_sfx_and_enter_copy_mode, 10, 24
        .addr $0000 ; end of list

; Because on this screen we need to reach in and manipulate... everything
FILE_SELECT_CONTROLLER_INDEX = 0
FILE_SELECT_CURSOR_INDEX = 1
FILE_SELECT_TITLE_INDEX  = 2
FILE_SELECT_FILE_1_INDEX = 3
FILE_SELECT_FILE_2_INDEX = 4
FILE_SELECT_FILE_3_INDEX = 5
FILE_SELECT_ERASE_BUTTON_INDEX = 6
FILE_SELECT_COPY_BUTTON_INDEX = 7

; these all go in the top bar to indicate mode
file_select_str:     .asciiz "FILE SELECT "
erase_which_str:     .asciiz "ERASE WHICH?"
erase_confirm_str:   .asciiz "REALLY !?   "
copy_source_str:     .asciiz "COPY WHICH? "
copy_dest_str:       .asciiz "WHERE TO?   "
copy_confirm_str:    .asciiz "OVERWRITE?  "

erase_file_str: .asciiz "ERASE FILE"
copy_file_str: .asciiz "COPY FILE"

DARK_SQUARE_TILE = $06
LIGHT_SQUARE_TILE = $07

FILE_SELECT_MODE_NORMAL        = 0
FILE_SELECT_MODE_ERASE         = 1
FILE_SELECT_MODE_ERASE_CONFIRM = 2
FILE_SELECT_MODE_COPY_SOURCE   = 3
FILE_SELECT_MODE_COPY_DEST     = 4
FILE_SELECT_MODE_COPY_CONFIRM  = 5

.segment "CODE_UI_LAYOUTS"

.proc FAR_draw_checkerboard_base
NametableAddr := R0
AttributeAddr := R2
CheckTracker := R4
RowCounter := R5
        perform_zpcm_inc
        st16 NametableAddr, $5000
        st16 AttributeAddr, $5800
        ldy #0
        sty CheckTracker
        sty RowCounter
row_loop:
        lda CheckTracker
        eor #1
        sta CheckTracker
col_loop:
        perform_zpcm_inc
        lda CheckTracker
        eor #1
        sta CheckTracker
        beq dark_square
light_square:
        lda #LIGHT_SQUARE_TILE
        jmp tile_converge
dark_square:
        lda #DARK_SQUARE_TILE
tile_converge:
        sta (NametableAddr), y
        lda #(CHR_BANK_FONT_MARSHMALLOW | UI_PAL_BG3)
        sta (AttributeAddr), y
        iny
        cpy #32
        bne col_loop
        ldy #0
        add16b NametableAddr, #32
        add16b AttributeAddr, #32
        inc RowCounter
        lda RowCounter
        cmp #30
        bne row_loop
        perform_zpcm_inc
        rts
.endproc

.proc FAR_apply_standard_ui_palette
        ldy #0
bg_loop:
        perform_zpcm_inc
        lda checkerboard_ui_palette_normal, y
        sta IncomingHwPalette, y
        iny
        cpy #16
        bne bg_loop

        far_call FAR_set_bg_target_palette_from_hw
        far_call FAR_set_bg_current_palette_from_target

        ldy #0
obj_loop:
        perform_zpcm_inc        
        lda options_obj_palette, y
        sta IncomingHwPalette, y
        iny
        cpy #16
        bne obj_loop

        far_call FAR_set_obj_palette_from_hw

        rts
.endproc

.proc FAR_apply_danger_ui_palette
        ldy #0
bg_loop:
        perform_zpcm_inc
        lda checkerboard_ui_palette_danger, y
        sta IncomingHwPalette, y
        iny
        cpy #16
        bne bg_loop

        far_call FAR_set_bg_target_palette_from_hw
        far_call FAR_set_bg_current_palette_from_target

        ldy #0
obj_loop:
        perform_zpcm_inc        
        lda options_obj_palette, y
        sta IncomingHwPalette, y
        iny
        cpy #16
        bne obj_loop

        far_call FAR_set_obj_palette_from_hw

        rts
.endproc

.proc FAR_file_select_controller_init
Top := R0
Left := R1
Width := R2
Height := R3

CurrentWidgetIndex := R20
widget_file_select_mode := widgets_data0

        perform_zpcm_inc
        ; Play the ... I dunno, the OPTIONS track on the file select screen, for now.
        ; TODO: a file select theme? or we just use options for this whole set
        lda #TRACK_OPTIONS
        ldy #TRACK_VARIANT_NORMAL
        jsr play_track

        ; this screen DOES use extended attributes, so set that up
        lda #0
        sta LeftNametableBank
        sta RightNametableBank
        lda #(NT_FPGA_RAM | NT_EXT_BANK_2 | NT_EXT_BG_AT)
        sta LeftNametableAttr
        sta RightNametableAttr

        ; draw an initial checkerboard background (no nametable for now)
        near_call FAR_draw_checkerboard_base
        ; draw boxes for the "File Select" top thing, and the "erase/copy" options down below
        lda #7
        sta Left
        lda #2
        sta Top
        lda #17
        sta Width
        lda #3
        sta Height
        far_call widget_file_select_box::FAR_draw_box_outline_light
        far_call widget_file_select_box::FAR_draw_box_fill
        far_call widget_file_select_box::FAR_draw_box_shadow

        lda #8
        sta Left
        lda #21
        sta Top
        lda #14
        sta Width
        lda #5
        sta Height
        far_call widget_file_select_box::FAR_draw_box_outline_light
        far_call widget_file_select_box::FAR_draw_box_fill
        far_call widget_file_select_box::FAR_draw_box_shadow

        near_call FAR_apply_standard_ui_palette

        lda #BRIGHTNESS_FULLY_DARK
        jsr set_brightness
        lda #BRIGHTNESS_NORMAL
        sta TargetBrightness

        ldy CurrentWidgetIndex
        lda #FILE_SELECT_MODE_NORMAL
        sta widget_file_select_mode, y
        set_widget_state_y FAR_file_select_controller_default_cursor
        rts
.endproc

.proc FAR_file_select_controller_default_cursor
CurrentWidgetIndex := R20

widget_cursor_nav_index := widgets_data1
widget_sprite_position_low_x := widgets_data2
widget_sprite_position_low_y := widgets_data3
widget_sprite_position_high_x := widgets_data4
widget_sprite_position_high_y := widgets_data5

        ; Now that we've initialized all widgets, detect the location of the
        ; last-used file and move the cursor there
        lda current_block + SaveBlock::LastUsedSlot
        clc
        adc #FILE_SELECT_FILE_1_INDEX
        ldy #FILE_SELECT_CURSOR_INDEX
        sta widget_cursor_nav_index, y

        ; same as snap to position, just without the hardcoded indexes
        tax
        lda widgets_cursor_pos_x, x
        sta widget_sprite_position_high_x, y
        lda widgets_cursor_pos_y, x
        sta widget_sprite_position_high_y, y
        ldy CurrentWidgetIndex
        lda #0
        sta widget_sprite_position_low_x, y
        sta widget_sprite_position_low_y, y

        ldy CurrentWidgetIndex
        set_widget_state_y FAR_file_select_controller_update
        rts
.endproc

.proc FAR_file_select_controller_update
        lda #KEY_B
        and ButtonsDown
        beq stay_here
        ; What we do very much depends on our current state
        near_call FAR_file_select_b_button_dispatch
stay_here:
        rts
.endproc

file_cancel_dispatch_table:
        .addr FAR_from_file_select_return_to_title ; FILE_SELECT_MODE_NORMAL
        .addr FAR_enter_normal_mode                ; FILE_SELECT_MODE_ERASE
        .addr FAR_enter_erase_mode                 ; FILE_SELECT_MODE_ERASE_CONFIRM
        .addr FAR_enter_normal_mode                ; FILE_SELECT_MODE_COPY_SOURCE
        .addr FAR_enter_copy_mode                  ; FILE_SELECT_MODE_COPY_DEST
        .addr FAR_enter_copy_dest_mode             ; FILE_SELECT_MODE_COPY_CONFIRM

.proc FAR_from_file_select_return_to_title
        far_call FAR_return_to_title
        rts
.endproc

.proc FAR_file_select_b_button_dispatch
DispatchPtr := R0
widget_file_select_mode := widgets_data0
        ; For everything except return to title, play a cancel sfx
        ; (return to title plays teleport SFX instead)
        ldy #FILE_SELECT_CONTROLLER_INDEX
        lda widget_file_select_mode, y
        beq done_with_sfx

        queue_sfx_pulse1 sfx_dialog_close

done_with_sfx:
        ldy #FILE_SELECT_CONTROLLER_INDEX
        lda widget_file_select_mode, y
        asl
        tay
        lda file_cancel_dispatch_table+0, y
        sta DispatchPtr+0
        lda file_cancel_dispatch_table+1, y
        sta DispatchPtr+1
        jmp (DispatchPtr)
.endproc

; These are the routines actually run when files are clicked, including a dispatch based on mode.
; Some of these repoint the cursor and/or disable nav to certain elements. Upon entry, A is the
; chosen file index. (If needed, this can be re-read with CurrentWidgetIndex in R20)

file_action_dispatch_table:
        .addr FAR_with_file_open           ; FILE_SELECT_MODE_NORMAL
        .addr FAR_with_file_try_erase      ; FILE_SELECT_MODE_ERASE
        .addr FAR_with_file_erase          ; FILE_SELECT_MODE_ERASE_CONFIRM
        .addr FAR_with_file_set_copy_dest  ; FILE_SELECT_MODE_COPY_SOURCE
        .addr FAR_with_file_try_copy       ; FILE_SELECT_MODE_COPY_DEST
        .addr FAR_with_file_perform_copy   ; FILE_SELECT_MODE_COPY_CONFIRM

.proc FAR_with_file_perform_action
DispatchPtr := R0
widget_file_select_mode := widgets_data0
        ldy #FILE_SELECT_CONTROLLER_INDEX
        lda widget_file_select_mode, y
        asl
        tay
        lda file_action_dispatch_table+0, y
        sta DispatchPtr+0
        lda file_action_dispatch_table+1, y
        sta DispatchPtr+1
        jmp (DispatchPtr)
.endproc

; Immediately open the selected file. No fuss.
.proc FAR_with_file_open
WidgetIndexUnderCursor := R20
widget_file_index := widgets_data2

        ldy WidgetIndexUnderCursor
        lda widget_file_index, y
        far_call widget_file_select_box::FAR_prepare_file_pointer
        far_call FAR_is_new_file
        cmp #FILE_NEW
        beq open_new_file
open_existing_file:
        ; FOR NOW, go to name entry anyway.
        ; Later, this should skip name entry and
        ; instead land on the "file details" screen
        ldy WidgetIndexUnderCursor
        lda widget_file_index, y
        far_call FAR_load_file
        far_call FAR_compute_player_colors
        ldy WidgetIndexUnderCursor
        lda widget_file_index, y
        far_call FAR_update_last_accessed_file
        far_call FAR_go_to_file_details
        rts

open_new_file:
        ldy WidgetIndexUnderCursor
        lda widget_file_index, y
        far_call FAR_load_file
        far_call FAR_init_file_options
        far_call FAR_compute_player_colors
        ldy WidgetIndexUnderCursor
        lda widget_file_index, y
        far_call FAR_update_last_accessed_file
        far_call FAR_go_to_name_entry
        rts
.endproc

.proc FAR_with_file_try_erase
WidgetIndexUnderCursor := R20

widget_file_index := widgets_data2

widget_copy_source_index := widgets_data1

        ; if the source selected is a new file. let's check for that
        ldy WidgetIndexUnderCursor
        lda widget_file_index, y
        far_call widget_file_select_box::FAR_prepare_file_pointer
        far_call FAR_is_new_file
        cmp #FILE_NEW
        bne perform_erase_confirm
        ; Fail (and stay in this mode). Play a buzzer SFX to indicate sadness!
        queue_sfx_pulse1 sfx_too_poor_pulse1
        queue_sfx_pulse2 sfx_too_poor_pulse2
        rts

perform_erase_confirm:
        queue_sfx_pulse1 sfx_dialog_advance

        near_call FAR_enter_erase_confirm_mode
        rts
.endproc

; Actually perform erasure. Enter normal mode.
.proc FAR_with_file_erase
WidgetIndexUnderCursor := R20
widget_file_index := widgets_data2
        
        ; To "erase" a file we're really just creating a new one,
        ; so do that
        ldy WidgetIndexUnderCursor
        lda widget_file_index, y
        far_call widget_file_select_box::FAR_prepare_file_pointer
        far_call FAR_create_new_file
        ; Persist those changes!
        far_call FAR_persist_block_to_storage
        ; This has invalidated the displayed contents of this file
        ; block, so have it refresh its contents accordingly
        ldy WidgetIndexUnderCursor
        set_widget_state_y widget_file_select_box::FAR_widget_file_select_box_refresh
        ; play a suitable "file erased" SFX, which is also the death sound
        queue_sfx_pulse1 sfx_death_spin_pulse
        queue_sfx_triangle sfx_death_spin_tri

        ; Move back to normal mode!
        near_call FAR_enter_normal_mode

        rts
.endproc

.proc FAR_with_file_set_copy_dest
WidgetIndexUnderCursor := R20

widget_file_index := widgets_data2

widget_copy_source_index := widgets_data1

        ; if the source selected is a new file. let's check for that
        ldy WidgetIndexUnderCursor
        lda widget_file_index, y
        far_call widget_file_select_box::FAR_prepare_file_pointer
        far_call FAR_is_new_file
        cmp #FILE_NEW
        bne perform_copy_source_select
        ; Fail (and stay in this mode). Play a buzzer SFX to indicate sadness!
        queue_sfx_pulse1 sfx_too_poor_pulse1
        queue_sfx_pulse2 sfx_too_poor_pulse2
        rts

perform_copy_source_select:
        ; Remember THIS index as our copy source, we'll need it to actually perform the copy later
        ldy WidgetIndexUnderCursor
        lda widget_file_index, y
        ldy #FILE_SELECT_CONTROLLER_INDEX
        sta widget_copy_source_index, y
        ; Play an advance SFX
        queue_sfx_pulse1 sfx_dialog_advance

        near_call FAR_enter_copy_dest_mode
        rts
.endproc

.proc FAR_with_file_try_copy
WidgetIndexUnderCursor := R20

widget_file_index := widgets_data2

widget_copy_source_index := widgets_data1

        ; First a sanity check: we can't copy a file into the same slot. If the user
        ; tries to request this, audibly laugh at them and do nothing
        ; (this shouldn't be reachable anyway, we disable selecting the same slot
        ; during copy dest, but it's better to be safe)
        ldy #FILE_SELECT_CONTROLLER_INDEX
        lda widget_copy_source_index, y
        ldy WidgetIndexUnderCursor
        cmp widget_file_index, y
        bne copy_dest_is_valid
        queue_sfx_pulse1 sfx_too_poor_pulse1
        queue_sfx_pulse2 sfx_too_poor_pulse2
        rts

copy_dest_is_valid:
        ; Now check to see if this is a new slot. If it is, we can perform the copy
        ; right away
        ldy WidgetIndexUnderCursor
        lda widget_file_index, y
        far_call widget_file_select_box::FAR_prepare_file_pointer
        far_call FAR_is_new_file
        cmp #FILE_NEW
        beq dest_slot_is_new_file
dest_slot_is_existing_file:
        ; There is another file here already, so enter the warning stage to give
        ; the user one last chance to back out
        near_call FAR_enter_copy_confirm_mode
        rts
dest_slot_is_new_file:
        near_call FAR_with_file_perform_copy
        rts
.endproc

.proc FAR_with_file_perform_copy
WidgetIndexUnderCursor := R20

widget_file_index := widgets_data2

widget_copy_source_index := widgets_data1

        ; This is simple enough: load the file from the source index
        ldy #FILE_SELECT_CONTROLLER_INDEX
        lda widget_copy_source_index, y
        far_call FAR_load_file
        ; Then save it over the destination index
        ldy WidgetIndexUnderCursor
        lda widget_file_index, y
        far_call FAR_save_file
        ; Similar to erasures, this invalidates the displayed contents of the
        ; destination widget, so refresh that here
        ldy WidgetIndexUnderCursor
        set_widget_state_y widget_file_select_box::FAR_widget_file_select_box_refresh

        ; Play some sort of chime for a successful copy. I dunno, pause?
        queue_sfx_pulse1 sfx_pause


        ; Move back to normal mode!
        near_call FAR_enter_normal_mode
        rts
.endproc

.proc _enable_copy_erase_buttons
        ldy #FILE_SELECT_ERASE_BUTTON_INDEX
        lda widgets_state_flags, y
        ora #WIDGET_STATE_NAVIGABLE
        sta widgets_state_flags, y
        ldy #FILE_SELECT_COPY_BUTTON_INDEX
        lda widgets_state_flags, y
        ora #WIDGET_STATE_NAVIGABLE
        sta widgets_state_flags, y
        rts
.endproc

.proc _enable_all_file_boxes
        ldy #FILE_SELECT_FILE_1_INDEX
        lda widgets_state_flags, y
        ora #WIDGET_STATE_NAVIGABLE
        sta widgets_state_flags, y
        ldy #FILE_SELECT_FILE_2_INDEX
        lda widgets_state_flags, y
        ora #WIDGET_STATE_NAVIGABLE
        sta widgets_state_flags, y
        ldy #FILE_SELECT_FILE_3_INDEX
        lda widgets_state_flags, y
        ora #WIDGET_STATE_NAVIGABLE
        sta widgets_state_flags, y
        rts
.endproc

.proc _disable_copy_erase_buttons
        ldy #FILE_SELECT_ERASE_BUTTON_INDEX
        lda widgets_state_flags, y
        and #($FF-WIDGET_STATE_NAVIGABLE)
        sta widgets_state_flags, y
        ldy #FILE_SELECT_COPY_BUTTON_INDEX
        lda widgets_state_flags, y
        and #($FF-WIDGET_STATE_NAVIGABLE)
        sta widgets_state_flags, y
        rts
.endproc

.proc _disable_all_file_boxes
        ldy #FILE_SELECT_FILE_1_INDEX
        lda widgets_state_flags, y
        and #($FF-WIDGET_STATE_NAVIGABLE)
        sta widgets_state_flags, y
        ldy #FILE_SELECT_FILE_2_INDEX
        lda widgets_state_flags, y
        and #($FF-WIDGET_STATE_NAVIGABLE)
        sta widgets_state_flags, y
        ldy #FILE_SELECT_FILE_3_INDEX
        lda widgets_state_flags, y
        and #($FF-WIDGET_STATE_NAVIGABLE)
        sta widgets_state_flags, y
        rts
.endproc

.proc FAR_enter_normal_mode
widget_file_select_mode := widgets_data0
widget_text_string_low := widgets_data2
widget_text_string_high := widgets_data3

        ldy #FILE_SELECT_CONTROLLER_INDEX
        lda #FILE_SELECT_MODE_NORMAL
        sta widget_file_select_mode, y

        ; Draw the normal message up top
        ldy #FILE_SELECT_TITLE_INDEX
        lda #<file_select_str
        sta widget_text_string_low, y
        lda #>file_select_str
        sta widget_text_string_high, y
        set_widget_state_y widget_text_label::FAR_widget_text_label_init

        ; Re-enable all nav buttons (incl. file boxes!)
        jsr _enable_copy_erase_buttons
        jsr _enable_all_file_boxes

        near_call FAR_apply_standard_ui_palette

        rts
.endproc

.proc FAR_play_sfx_and_enter_erase_mode
        queue_sfx_pulse1 sfx_dialog_advance
        near_call FAR_enter_erase_mode
        rts
.endproc

; Various utilities used by the above states
.proc FAR_enter_erase_mode
widget_file_select_mode := widgets_data0
widget_text_string_low := widgets_data2
widget_text_string_high := widgets_data3
        
        ldy #FILE_SELECT_CONTROLLER_INDEX
        lda #FILE_SELECT_MODE_ERASE
        sta widget_file_select_mode, y

        ; Draw the erase which message up top
        ldy #FILE_SELECT_TITLE_INDEX
        lda #<erase_which_str
        sta widget_text_string_low, y
        lda #>erase_which_str
        sta widget_text_string_high, y
        set_widget_state_y widget_text_label::FAR_widget_text_label_init

        ; Disable navigation for the two mode buttons
        jsr _disable_copy_erase_buttons

        ; Enable nav for all 3 boxes
        jsr _enable_all_file_boxes

        ; If we're pointing to the erase button, move the cursor. (Otherwise leave it alone)
        ; ...Handled automatically by cursor update!

        near_call FAR_apply_danger_ui_palette

        rts
.endproc

.proc FAR_enter_erase_confirm_mode
WidgetIndexUnderCursor := R20

widget_file_select_mode := widgets_data0
widget_text_string_low := widgets_data2
widget_text_string_high := widgets_data3
        ldy #FILE_SELECT_CONTROLLER_INDEX
        lda #FILE_SELECT_MODE_ERASE_CONFIRM
        sta widget_file_select_mode, y

        ; Draw the erase confirm message up top
        ldy #FILE_SELECT_TITLE_INDEX
        lda #<erase_confirm_str
        sta widget_text_string_low, y
        lda #>erase_confirm_str
        sta widget_text_string_high, y
        set_widget_state_y widget_text_label::FAR_widget_text_label_init

        ; Disable nav for every box other than the one we're pointing to
        ; the lazy way: disable all 3
        jsr _disable_all_file_boxes
        ; ... and now re-enable the one we're pointing to
        ldy WidgetIndexUnderCursor
        lda widgets_state_flags, y
        ora #WIDGET_STATE_NAVIGABLE
        sta widgets_state_flags, y

        queue_sfx_pulse1 sfx_siren_pulse_1
        queue_sfx_pulse2 sfx_siren_pulse_2

        near_call FAR_apply_danger_ui_palette

        rts
.endproc

.proc FAR_play_sfx_and_enter_copy_mode
        queue_sfx_pulse1 sfx_dialog_advance
        near_call FAR_enter_copy_mode
        rts
.endproc

.proc FAR_enter_copy_mode
WidgetIndexUnderCursor := R20

widget_file_select_mode := widgets_data0
widget_text_string_low := widgets_data2
widget_text_string_high := widgets_data3

        ldy #FILE_SELECT_CONTROLLER_INDEX
        lda #FILE_SELECT_MODE_COPY_SOURCE
        sta widget_file_select_mode, y

        ; Draw the copy which message up top
        ldy #FILE_SELECT_TITLE_INDEX
        lda #<copy_source_str
        sta widget_text_string_low, y
        lda #>copy_source_str
        sta widget_text_string_high, y
        set_widget_state_y widget_text_label::FAR_widget_text_label_init

        ; Disable navigation for the two mode buttons
        jsr _disable_copy_erase_buttons

        ; Enable navigation for all 3 boxes (this will undo selective navigation
        ; during copy dest mode, if canceled)
        jsr _enable_all_file_boxes

        near_call FAR_apply_standard_ui_palette

        rts
.endproc

.proc FAR_enter_copy_dest_mode
WidgetIndexUnderCursor := R20

widget_file_select_mode := widgets_data0
widget_text_string_low := widgets_data2
widget_text_string_high := widgets_data3

widget_file_index := widgets_data2

widget_copy_source_index := widgets_data1

        ldy #FILE_SELECT_CONTROLLER_INDEX
        lda #FILE_SELECT_MODE_COPY_DEST
        sta widget_file_select_mode, y

        ; Draw the copy to message up top
        ldy #FILE_SELECT_TITLE_INDEX
        lda #<copy_dest_str
        sta widget_text_string_low, y
        lda #>copy_dest_str
        sta widget_text_string_high, y
        set_widget_state_y widget_text_label::FAR_widget_text_label_init

        ; Enable nav for all 3 boxes 
        jsr _enable_all_file_boxes
        ; ...and disable nav for the copy source, which should move the cursor to the first
        ; of the other slots that are available
        ldy #FILE_SELECT_CONTROLLER_INDEX
        lda widget_copy_source_index, y
        clc
        adc #FILE_SELECT_FILE_1_INDEX
        tay
        lda widgets_state_flags, y
        and #($FF-WIDGET_STATE_NAVIGABLE)
        sta widgets_state_flags, y

        near_call FAR_apply_standard_ui_palette

        rts
.endproc

.proc FAR_enter_copy_confirm_mode
WidgetIndexUnderCursor := R20

widget_file_select_mode := widgets_data0
widget_text_string_low := widgets_data2
widget_text_string_high := widgets_data3

widget_copy_source_index := widgets_data1

        ; At this point validation has already been performed (this isn't a new file
        ; and we aren't trying to copy onto ourselves) so just perform the switch
        ; somewhat blindly

        ldy #FILE_SELECT_CONTROLLER_INDEX
        lda #FILE_SELECT_MODE_COPY_CONFIRM
        sta widget_file_select_mode, y

        ; Draw the overwrite message up top
        ldy #FILE_SELECT_TITLE_INDEX
        lda #<copy_confirm_str
        sta widget_text_string_low, y
        lda #>copy_confirm_str
        sta widget_text_string_high, y
        set_widget_state_y widget_text_label::FAR_widget_text_label_init

        ; disable nav for everything that isn't the thing we're pointed at
        jsr _disable_all_file_boxes
        ; ... and now re-enable the one we're pointing to
        ldy WidgetIndexUnderCursor
        lda widgets_state_flags, y
        ora #WIDGET_STATE_NAVIGABLE
        sta widgets_state_flags, y

        queue_sfx_pulse1 sfx_siren_pulse_1
        queue_sfx_pulse2 sfx_siren_pulse_2

        near_call FAR_apply_danger_ui_palette

        rts
.endproc

