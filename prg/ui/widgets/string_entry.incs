.endproc

.proc add_to_string
    ; First, check the string length. If it's already 15 or higher, buzz and fail.
    ; Add this glyph to the end of the pointed-at string, followed by a $0 byte
    ; draw the string again
.endproc

.proc delete_from_string
    ; First, check the string length. If it is already 0, buzz and fail.
    ; Remove the glyph at the end of the pointed-at string, replacing it with a $0 byte
    ; draw the string again
.endproc

.proc draw_current_page
PagePtr := R0
PageTablePtr := R2

CurrentWidgetIndex := R20

    widget_page_table_low := widgets_data0
    widget_page_table_high := widgets_data1
    widget_current_page := widgets_data4

    ldy CurrentWidgetIndex
    lda widget_current_page, y
    lda widget_page_table_low, y
    sta PageTablePtr+0
    lda widget_page_table_high, y
    sta PageTablePtr+1
    lda widget_current_page, y
    asl ; each entry is two pointers == 4 bytes
    asl
    clc
    adc #2 ; grab the second pointer, to the actual letter grid
    tay
    lda (PageTablePtr), y
    sta PagePtr+0
    iny
    lda (PageTablePtr), y
    sta PagePtr+1
    jsr draw_letter_grid
    rts
.endproc

.proc widget_string_entry_init
    widget_page_table_low := widgets_data0
    widget_page_table_high := widgets_data1
    widget_target_string_low := widgets_data2
    widget_target_string_high := widgets_data3
    widget_current_page := widgets_data4

CurrentWidgetIndex := R20

    ldy CurrentWidgetIndex
    lda #1
    sta widget_current_page, y

    jsr draw_current_page
    jsr draw_controls

    ldy CurrentWidgetIndex
    set_widget_state_y widget_string_entry_update
    rts
.endproc

.proc widget_string_entry_update
    ; TODO: all of this!
    rts
.endproc