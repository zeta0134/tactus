; These are fixed on the screen, and I'm not going to waste effort
; trying to make them relocatable. Deal.
.macro widget_string_entry page_table, destination_str
        .addr widget_string_entry_init
        .addr page_table
        .addr destination_str
        .byte 0, 0, 0, 0
        ; the string entry thing comes with its own cursor
        .addr widget_string_entry_cursor_init
        .byte 0, 0, 0, 0
        .byte 0, 0, 0, 0
.endmacro

.segment "CODE_UI_WIDGETS"

TARGET_STRING_TOP_TILE  = 9
TARGET_STRING_LEFT_TILE = 8

NAME_ENTRY_LEFT_TILE = 5
NAME_ENTRY_TOP_TILE  = 13

BUTTONS_LEFT_TILE = 22
PAGE_NAME_ROW = 13
DEL_ROW       = 15
CONFIRM_ROW   = 17

.proc draw_letter_grid
PagePtr := R0
NametableAddr := R2
AttributeAddr := R4
RowCounter := R6
ColCounter := R7
TOP_LEFT_NAMETABLE  = $5000 + (NAME_ENTRY_TOP_TILE * 32) + NAME_ENTRY_LEFT_TILE
TOP_LEFT_ATTRIBUTE = TOP_LEFT_NAMETABLE + $800

CurrentWidgetIndex := R20

widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6

        ldx CurrentWidgetIndex

        st16 NametableAddr, TOP_LEFT_NAMETABLE
        st16 AttributeAddr, TOP_LEFT_ATTRIBUTE
        lda #0
        sta RowCounter
row_loop:
        lda #0
        sta ColCounter
col_loop:
        perform_zpcm_inc
        ldy ColCounter
        lda (PagePtr), y
        pha
        lda ColCounter
        asl
        tay
        pla
        sta (NametableAddr), y
        lda ColCounter
        cmp widget_grid_pos_x, x
        bne no_highlight
        lda RowCounter
        cmp widget_grid_pos_y, x
        bne no_highlight
highlight:
        lda #(CHR_BANK_FONT_MARSHMALLOW | UI_PAL_BG1)
        jmp highlight_converge
no_highlight:
        lda #(CHR_BANK_FONT_MARSHMALLOW | UI_PAL_BG0)
highlight_converge:
        sta (AttributeAddr), y
        inc ColCounter
        lda ColCounter
        cmp #8
        bne col_loop
        add16b NametableAddr, #64
        add16b AttributeAddr, #64
        add16b PagePtr, #8
        inc RowCounter
        lda RowCounter
        cmp #6
        bne row_loop
        perform_zpcm_inc
        rts
.endproc

string_entry_del_str: .asciiz "Delete"
string_entry_accept_str: .asciiz "Accept"

.proc draw_controls
; FIXED_draw_string
NametableAddr := T0
AttributeAddr := T2
StringPtr := T4
TileBase := T6
PaletteIndex := T7

PageTablePtr := R2

CurrentWidgetIndex := R20

widget_page_table_low := widgets_data0
widget_page_table_high := widgets_data1
widget_target_string_low := widgets_data2
widget_target_string_high := widgets_data3
widget_current_page := widgets_data4
widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6

        ; Common setup for all string drawing to follow
        lda #CHR_BANK_FONT_MARSHMALLOW
        sta TileBase

        ; Draw the current page name

        ; If we are at the cursor position, then highlight this string
        ldy CurrentWidgetIndex
        lda widget_grid_pos_x, y
        cmp #8
        bne no_highlight_page_name
        lda widget_grid_pos_y, y
        cmp #0
        bne no_highlight_page_name
highlight_page_name:
        lda #UI_PAL_BG1
        jmp page_name_highlight_converge
no_highlight_page_name:
        lda #UI_PAL_BG0
page_name_highlight_converge:
        sta PaletteIndex

        ldy CurrentWidgetIndex
        lda widget_current_page, y
        lda widget_page_table_low, y
        sta PageTablePtr+0
        lda widget_page_table_high, y
        sta PageTablePtr+1
        lda widget_current_page, y
        asl ; each entry is two pointers == 4 bytes
        asl
        tay
        lda (PageTablePtr), y
        sta StringPtr+0
        iny
        lda (PageTablePtr), y
        sta StringPtr+1
        st16 NametableAddr, ($5000 + (PAGE_NAME_ROW * 32) + BUTTONS_LEFT_TILE)
        st16 AttributeAddr, ($5800 + (PAGE_NAME_ROW * 32) + BUTTONS_LEFT_TILE)
        jsr FIXED_draw_string
        ; Draw the delete string

        ; If we are at the cursor position, then highlight this string
        ldy CurrentWidgetIndex
        lda widget_grid_pos_x, y
        cmp #8
        bne no_highlight_delete
        lda widget_grid_pos_y, y
        cmp #1
        bne no_highlight_delete
highlight_delete:
        lda #UI_PAL_BG1
        jmp delete_highlight_converge
no_highlight_delete:
        lda #UI_PAL_BG0
delete_highlight_converge:
        sta PaletteIndex

        st16 StringPtr, string_entry_del_str
        st16 NametableAddr, ($5000 + (DEL_ROW * 32) + BUTTONS_LEFT_TILE)
        st16 AttributeAddr, ($5800 + (DEL_ROW * 32) + BUTTONS_LEFT_TILE)
        jsr FIXED_draw_string

        ; If we are at the cursor position, then highlight this string
        ldy CurrentWidgetIndex
        lda widget_grid_pos_x, y
        cmp #8
        bne no_highlight_accept
        lda widget_grid_pos_y, y
        cmp #2
        bne no_highlight_accept
highlight_accept:
        lda #UI_PAL_BG1
        jmp accept_highlight_converge
no_highlight_accept:
        lda #UI_PAL_BG0
accept_highlight_converge:
        sta PaletteIndex

        st16 StringPtr, string_entry_accept_str
        st16 NametableAddr, ($5000 + (CONFIRM_ROW * 32) + BUTTONS_LEFT_TILE)
        st16 AttributeAddr, ($5800 + (CONFIRM_ROW * 32) + BUTTONS_LEFT_TILE)
        jsr FIXED_draw_string
        rts
.endproc

.proc advance_page
PagePtr := R0
PageTablePtr := R2

CurrentWidgetIndex := R20

widget_page_table_low := widgets_data0
widget_page_table_high := widgets_data1
widget_target_string_low := widgets_data2
widget_target_string_high := widgets_data3
widget_current_page := widgets_data4

        ldy CurrentWidgetIndex
        ; Increment the page number
        lda widget_current_page, y
        clc
        adc #1
        sta widget_current_page, y
        ; Read the new entry from the page table
        lda widget_page_table_low, y
        sta PageTablePtr+0
        lda widget_page_table_high, y
        sta PageTablePtr+1
        lda widget_current_page, y
        asl ; each entry is two pointers == 4 bytes
        asl
        tay
        ; If it is $0000, reset the page number to 0
        lda (PageTablePtr), y
        iny
        ora (PageTablePtr), y
        bne page_in_range
        lda #0
        ldy CurrentWidgetIndex
        sta widget_current_page, y
page_in_range:
        ; draw the letter grid and refresh the controls
        jsr draw_current_page
        jsr draw_controls
        queue_sfx_pulse2 sfx_dialog_advance
        rts
.endproc

.proc draw_current_page
PagePtr := R0
PageTablePtr := R2

CurrentWidgetIndex := R20

widget_page_table_low := widgets_data0
widget_page_table_high := widgets_data1
widget_current_page := widgets_data4

        ldy CurrentWidgetIndex
        lda widget_page_table_low, y
        sta PageTablePtr+0
        lda widget_page_table_high, y
        sta PageTablePtr+1
        lda widget_current_page, y
        asl ; each entry is two pointers == 4 bytes
        asl
        clc
        adc #2 ; grab the second pointer, to the actual letter grid
        tay
        lda (PageTablePtr), y
        sta PagePtr+0
        iny
        lda (PageTablePtr), y
        sta PagePtr+1
        jsr draw_letter_grid
        rts
.endproc

NAME_ENTRY_UNDERLINE_TILE = $E4
NAME_ENTRY_TEXT_CURSOR    = $E3
NAME_ENTRY_END_CURSOR     = $E1

.proc draw_string_ui

NametableAddr := T0
AttributeAddr := T2
        perform_zpcm_inc
        ; TODO: a little icon on the left side?

        st16 NametableAddr, ($5000 + ((TARGET_STRING_TOP_TILE + 1) * 32) + TARGET_STRING_LEFT_TILE)
        st16 AttributeAddr, ($5800 + ((TARGET_STRING_TOP_TILE + 1) * 32) + TARGET_STRING_LEFT_TILE)

        ldy #0
loop:
        perform_zpcm_inc
        lda #NAME_ENTRY_UNDERLINE_TILE
        sta (NametableAddr), y
        lda #CHR_BANK_FONT_MARSHMALLOW
        sta (AttributeAddr), y
        iny
        cpy #15
        bne loop

        perform_zpcm_inc
        rts
.endproc

.proc draw_target_string
; FIXED_draw_string
NametableAddr := T0
AttributeAddr := T2
StringPtr := T4
TileBase := T6
PaletteIndex := T7

CurrentWidgetIndex := R20

widget_target_string_low := widgets_data2
widget_target_string_high := widgets_data3
        
        st16 NametableAddr, ($5000 + (TARGET_STRING_TOP_TILE * 32) + TARGET_STRING_LEFT_TILE)
        st16 AttributeAddr, ($5800 + (TARGET_STRING_TOP_TILE * 32) + TARGET_STRING_LEFT_TILE)

        ldy CurrentWidgetIndex
        lda widget_target_string_low, y
        sta StringPtr+0
        lda widget_target_string_high, y
        sta StringPtr+1

        lda #CHR_BANK_FONT_MARSHMALLOW
        sta TileBase
        lda #UI_PAL_BG1
        sta PaletteIndex
        jsr FIXED_draw_string
        ; at this point, the nametable/attribute pointers are still set
        ; and Y is pointing to the character after the string.
        ; are we at the end of the string?
        cpy #15
        beq draw_end_cursor
        ; draw the text editing cursor
        lda #NAME_ENTRY_TEXT_CURSOR
        sta (NametableAddr), y
        lda #(CHR_BANK_FONT_MARSHMALLOW | UI_PAL_BG0)
        sta (AttributeAddr), y
        iny
        cpy #16
        beq done
        ; clear out any text following this point
padding_loop:
        lda #0
        sta (NametableAddr), y
        iny
        cpy #16
        bne padding_loop
        rts

draw_end_cursor:
        lda #NAME_ENTRY_END_CURSOR
        sta (NametableAddr), y
        lda #(CHR_BANK_FONT_MARSHMALLOW | UI_PAL_BG0)
        sta (AttributeAddr), y
done:
        rts
.endproc

.proc add_to_string
StringPtr := T0
Length := T2

PagePtr := R0
PageTablePtr := R2

CurrentWidgetIndex := R20

widget_page_table_low := widgets_data0
widget_page_table_high := widgets_data1
widget_target_string_low := widgets_data2
widget_target_string_high := widgets_data3
widget_current_page := widgets_data4
widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6   

        ; First, check the string length. If it's already 15 or higher, buzz and fail.
        ldy CurrentWidgetIndex
        lda widget_target_string_low, y
        sta StringPtr+0
        lda widget_target_string_high, y
        sta StringPtr+1
        jsr FIXED_strlen
        lda Length
        cmp #15
        bcs fail_to_add
        ; Add the pointed-to glyph to the end of the pointed-at string, followed by a $0 byte
        ;; First, load in the active page table
        ldy CurrentWidgetIndex
        lda widget_page_table_low, y
        sta PageTablePtr+0
        lda widget_page_table_high, y
        sta PageTablePtr+1
        lda widget_current_page, y
        asl ; each entry is two pointers == 4 bytes
        asl
        clc
        adc #2 ; grab the second pointer, to the actual letter grid
        tay
        lda (PageTablePtr), y
        sta PagePtr+0
        iny
        lda (PageTablePtr), y
        sta PagePtr+1
        ;; now using the current grid coordinates, work out which byte to copy into
        ;; the destination string
        ldy CurrentWidgetIndex
        lda widget_grid_pos_y, y
        asl
        asl
        asl ; x8
        clc
        adc widget_grid_pos_x, y
        tay
        ;; grab the new glyph byte, and store it at "Length" which we computed before
        lda (PagePtr), y
        ldy Length
        sta (StringPtr), y
        ; follow this up with a $0 byte in the original string, to ensure it remains null-terminated
        iny
        lda #0
        sta (StringPtr), y
        ; finally, draw the string again
        jsr draw_target_string
        queue_sfx_pulse1 sfx_select_cursor
        rts
fail_to_add:
        queue_sfx_pulse1 sfx_cursor_fail
        rts
.endproc

.proc delete_from_string
StringPtr := T0
Length := T2

CurrentWidgetIndex := R20

widget_target_string_low := widgets_data2
widget_target_string_high := widgets_data3

        ; First, check the string length. If it is already 0, buzz and fail.
        ldy CurrentWidgetIndex
        lda widget_target_string_low, y
        sta StringPtr+0
        lda widget_target_string_high, y
        sta StringPtr+1
        jsr FIXED_strlen
        lda Length
        beq fail_to_add
        ; Remove the glyph at the end of the pointed-at string, replacing it with a $0 byte
        lda #0
        ldy Length
        dey
        sta (StringPtr), y
        ; finally, draw the string again
        jsr draw_target_string
        queue_sfx_pulse1 sfx_select_cursor
        rts
fail_to_add:
        queue_sfx_pulse1 sfx_cursor_fail
        rts
.endproc

.proc move_cursor_right
CurrentWidgetIndex := R20

widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6        

        ldy CurrentWidgetIndex
        lda widget_grid_pos_x, y
        cmp #8
        beq cancel_move
        clc
        adc #1
        sta widget_grid_pos_x, y
        cmp #8
        bne position_is_fine
        ; if we are further down than the "accept" button,
        ; move up to that spot
        lda widget_grid_pos_y, y
        cmp #2
        bcc position_is_fine
        lda #2
        sta widget_grid_pos_y, y
position_is_fine:
        jsr draw_current_page
        jsr draw_controls
        queue_sfx_pulse2 sfx_move_cursor
cancel_move:
        rts
.endproc

.proc move_cursor_left
CurrentWidgetIndex := R20

widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6        

        ldy CurrentWidgetIndex
        lda widget_grid_pos_x, y
        beq cancel_move
        sec
        sbc #1
        sta widget_grid_pos_x, y
        jsr draw_current_page
        jsr draw_controls
        queue_sfx_pulse2 sfx_move_cursor
cancel_move:
        rts
.endproc

.proc move_cursor_up
CurrentWidgetIndex := R20

widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6        

        ldy CurrentWidgetIndex
        lda widget_grid_pos_y, y
        beq cancel_move
        sec
        sbc #1
        sta widget_grid_pos_y, y
        jsr draw_current_page
        jsr draw_controls
        queue_sfx_pulse2 sfx_move_cursor
cancel_move:
        rts
.endproc

.proc move_cursor_down
CurrentWidgetIndex := R20

widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6        

        ldy CurrentWidgetIndex
        ; always cancel if we are on the bottom row
        lda widget_grid_pos_y, y
        cmp #5
        beq cancel_move
        ; if we are on the rightmost column...
        lda widget_grid_pos_x, y
        cmp #8
        bne allow_move
        ; then only allow up to the lowest button...
        lda widget_grid_pos_y, y
        cmp #2
        beq cancel_move
allow_move:
        lda widget_grid_pos_y, y
        clc
        adc #1
        sta widget_grid_pos_y, y
        jsr draw_current_page
        jsr draw_controls
        queue_sfx_pulse2 sfx_move_cursor
cancel_move:
        rts
.endproc

.proc jump_to_confirm
CurrentWidgetIndex := R20
widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6  
        ldy CurrentWidgetIndex
        lda #8
        sta widget_grid_pos_x, y
        lda #2
        sta widget_grid_pos_y, y
        jsr draw_current_page
        jsr draw_controls
        rts
.endproc

.proc perform_action_at_cursor
CurrentWidgetIndex := R20
widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6
        
        ldy CurrentWidgetIndex
        lda widget_grid_pos_x, y
        cmp #8
        bcs check_buttons
        jsr add_to_string
        rts
check_buttons:
        lda widget_grid_pos_y, y
        beq perform_page_advance
        cmp #1
        beq perform_deletion
        jsr accept_string
        rts
perform_page_advance:
        jsr advance_page
        rts
perform_deletion:
        jsr delete_from_string
        rts
.endproc

.proc accept_string
StringPtr := T0
Length := T2

CurrentWidgetIndex := R20

widget_target_string_low := widgets_data2
widget_target_string_high := widgets_data3
        ; Sanity check: is this string nonempty?
        ; If so, buzz and fail!
        ldy CurrentWidgetIndex
        lda widget_target_string_low, y
        sta StringPtr+0
        lda widget_target_string_high, y
        sta StringPtr+1
        jsr FIXED_strlen
        lda Length
        beq buzz_and_fail
        ; Otherwise, go ahead and save this file, then
        ; go to the options screen to allow the player
        ; to personalize their preferences
        far_call FAR_save_current_file
        jsr go_to_options
        rts

buzz_and_fail:
        queue_sfx_pulse1 sfx_too_poor_pulse1
        queue_sfx_pulse2 sfx_too_poor_pulse2
        rts
.endproc

.proc widget_string_entry_init
CurrentWidgetIndex := R20

widget_page_table_low := widgets_data0
widget_page_table_high := widgets_data1
widget_target_string_low := widgets_data2
widget_target_string_high := widgets_data3
widget_current_page := widgets_data4
widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6


        ldy CurrentWidgetIndex
        lda #0
        sta widget_current_page, y
        lda #0
        sta widget_grid_pos_x, y
        sta widget_grid_pos_y, y

        jsr draw_current_page
        jsr draw_controls
        jsr draw_string_ui
        jsr draw_target_string

        ldy CurrentWidgetIndex
        set_widget_state_y widget_string_entry_update
        rts
.endproc

.proc widget_string_entry_update

check_left:
        lda #(KEY_LEFT)
        bit ButtonsDown
        beq left_not_pressed
        jsr move_cursor_left
left_not_pressed:

check_right:
        lda #(KEY_RIGHT)
        bit ButtonsDown
        beq right_not_pressed
        jsr move_cursor_right
right_not_pressed:

check_up:
        lda #(KEY_UP)
        bit ButtonsDown
        beq up_not_pressed
        jsr move_cursor_up
up_not_pressed:

check_down:
        lda #(KEY_DOWN)
        bit ButtonsDown
        beq down_not_pressed
        jsr move_cursor_down
down_not_pressed:

check_a:
        lda #(KEY_A)
        bit ButtonsDown
        beq a_not_pressed
        jsr perform_action_at_cursor
a_not_pressed:

check_b:
        lda #(KEY_B)
        bit ButtonsDown
        beq b_not_pressed
        jsr delete_from_string
b_not_pressed:

check_start:
        lda #(KEY_START)
        bit ButtonsDown
        beq start_not_pressed
        jsr jump_to_confirm
start_not_pressed:

check_select:
        lda #(KEY_SELECT)
        bit ButtonsDown
        beq select_not_pressed
        jsr advance_page
select_not_pressed:

        ; TODO: update the fancy cursor box thing here!

        rts
.endproc

STRING_ENTRY_LEFT_OAM_INDEX = PAUSE_INDICATOR_OAM_INDEX
STRING_ENTRY_RIGHT_OAM_INDEX = PAUSE_INDICATOR_OAM_INDEX+1

.proc compute_grid_left_pos
PreviousWidgetIndex := R19
previous_widget_grid_pos_x   := widgets_data5
previous_widget_grid_pos_y   := widgets_data6
        ldy PreviousWidgetIndex
        lda previous_widget_grid_pos_x, y
        asl ; x2
        clc
        adc #NAME_ENTRY_LEFT_TILE ; +leftbase
        asl
        asl
        asl ; x8
        pha
        lda previous_widget_grid_pos_x, y
        cmp #8
        bne regular_offset
button_offset:
        pla
        clc
        adc #3
        rts
regular_offset:
        pla
        sec
        sbc #5
        rts
.endproc

.proc compute_grid_right_pos
PreviousWidgetIndex := R19
previous_widget_grid_pos_x   := widgets_data5
previous_widget_grid_pos_y   := widgets_data6
        jsr compute_grid_left_pos
        pha
        lda previous_widget_grid_pos_x, y
        cmp #8
        bne regular_offset
button_offset:
        pla
        clc
        adc #49
        rts
regular_offset:
        pla
        clc
        adc #9
        rts
.endproc

.proc compute_grid_top_pos
PreviousWidgetIndex := R19
previous_widget_grid_pos_x   := widgets_data5
previous_widget_grid_pos_y   := widgets_data6

        ldy PreviousWidgetIndex
        lda previous_widget_grid_pos_y, y
        asl ; x2
        clc
        adc #NAME_ENTRY_TOP_TILE ; +topbase
        asl
        asl
        asl ; x8
        ; TODO: total sprite offset to the left
        rts
.endproc

.proc widget_string_entry_cursor_init
PreviousWidgetIndex := R19
CurrentWidgetIndex := R20

previous_widget_grid_pos_x   := widgets_data5
previous_widget_grid_pos_y   := widgets_data6

widget_left_pos_x_pixel      := widgets_data0
widget_left_pos_x_subpixel   := widgets_data1
widget_left_pos_y_pixel      := widgets_data2
widget_left_pos_y_subpixel   := widgets_data3
widget_right_pos_x_pixel     := widgets_data4
widget_right_pos_x_subpixel  := widgets_data5
widget_right_pos_y_pixel     := widgets_data6
widget_right_pos_y_subpixel  := widgets_data7

        ldy CurrentWidgetIndex
        lda #0
        sta widget_left_pos_x_subpixel, y
        sta widget_left_pos_y_subpixel, y
        sta widget_right_pos_x_subpixel, y
        sta widget_right_pos_y_subpixel, y
        ldy CurrentWidgetIndex
        dey
        sty PreviousWidgetIndex

        jsr compute_grid_left_pos
        ldy CurrentWidgetIndex
        sta widget_left_pos_x_pixel, y
        jsr compute_grid_right_pos
        ldy CurrentWidgetIndex
        sta widget_right_pos_x_pixel, y

        jsr compute_grid_top_pos
        ldy CurrentWidgetIndex
        sta widget_left_pos_y_pixel, y
        sta widget_right_pos_y_pixel, y

        jsr draw_name_entry_cursor

        ldy CurrentWidgetIndex
        set_widget_state_y widget_string_entry_cursor_update
        rts
.endproc

.proc widget_string_entry_cursor_update
PreviousWidgetIndex := R19

; lerp coordinate
CurrentPos := R2
TargetPos := R4
Distance := R6

CurrentWidgetIndex := R20

previous_widget_grid_pos_x   := widgets_data5
previous_widget_grid_pos_y   := widgets_data6

widget_left_pos_x_pixel      := widgets_data0
widget_left_pos_x_subpixel   := widgets_data1
widget_left_pos_y_pixel      := widgets_data2
widget_left_pos_y_subpixel   := widgets_data3
widget_right_pos_x_pixel     := widgets_data4
widget_right_pos_x_subpixel  := widgets_data5
widget_right_pos_y_pixel     := widgets_data6
widget_right_pos_y_subpixel  := widgets_data7

        ldy CurrentWidgetIndex
        dey
        sty PreviousWidgetIndex

        perform_zpcm_inc
        
        ; left cursor, X lerp
        jsr compute_grid_left_pos
        sta TargetPos+1
        lda #0
        sta TargetPos+0
        ldy CurrentWidgetIndex
        lda widget_left_pos_x_pixel, y
        sta CurrentPos+1
        lda widget_left_pos_x_subpixel, y
        sta CurrentPos+0
        jsr lerp_coordinate
        perform_zpcm_inc
        ldy CurrentWidgetIndex
        lda CurrentPos+1
        sta widget_left_pos_x_pixel, y
        lda CurrentPos+0
        sta widget_left_pos_x_subpixel, y

        ; right cursor, X lerp
        jsr compute_grid_right_pos
        sta TargetPos+1
        lda #0
        sta TargetPos+0
        ldy CurrentWidgetIndex
        lda widget_right_pos_x_pixel, y
        sta CurrentPos+1
        lda widget_right_pos_x_subpixel, y
        sta CurrentPos+0
        jsr lerp_coordinate
        perform_zpcm_inc
        ldy CurrentWidgetIndex
        lda CurrentPos+1
        sta widget_right_pos_x_pixel, y
        lda CurrentPos+0
        sta widget_right_pos_x_subpixel, y

        ; both cursor halves, Y lerp
        jsr compute_grid_top_pos
        sta TargetPos+1
        lda #0
        sta TargetPos+0
        ldy CurrentWidgetIndex
        lda widget_left_pos_y_pixel, y
        sta CurrentPos+1
        lda widget_left_pos_y_subpixel, y
        sta CurrentPos+0
        jsr lerp_coordinate
        perform_zpcm_inc
        ldy CurrentWidgetIndex
        lda CurrentPos+1
        sta widget_left_pos_y_pixel, y
        sta widget_right_pos_y_pixel, y
        lda CurrentPos+0
        sta widget_left_pos_y_subpixel, y
        sta widget_right_pos_y_subpixel, y

        perform_zpcm_inc

        jsr draw_name_entry_cursor
        rts
.endproc

.proc draw_name_entry_cursor
SpritePtr := R0
CurrentWidgetIndex := R20

widget_left_pos_x_pixel      := widgets_data0
widget_left_pos_y_pixel      := widgets_data2
widget_right_pos_x_pixel     := widgets_data4
widget_right_pos_y_pixel     := widgets_data6

        perform_zpcm_inc
        ldx CurrentWidgetIndex ; Y is busy doing sprite things

        ldy #STRING_ENTRY_LEFT_OAM_INDEX
        lda sprite_ptr_lut_low, y
        sta SpritePtr+0
        lda sprite_ptr_lut_high, y
        sta SpritePtr+1

        lda #<SPRITE_UI_00_MENU_CURSOR_SQUARE + 0 + SPRITE_OFFSET_UI_00
        ldy #SelfModifiedSprite::TileId
        sta (SpritePtr), y
        lda #SPRITE_PAL_0
        ldy #SelfModifiedSprite::Attributes
        sta (SpritePtr), y
        lda widget_left_pos_x_pixel, x
        ldy #SelfModifiedSprite::PosX
        sta (SpritePtr), y
        lda widget_left_pos_y_pixel, x
        ldy #SelfModifiedSprite::PosY
        sta (SpritePtr), y

        perform_zpcm_inc

        ldy #STRING_ENTRY_RIGHT_OAM_INDEX
        lda sprite_ptr_lut_low, y
        sta SpritePtr+0
        lda sprite_ptr_lut_high, y
        sta SpritePtr+1

        lda #<SPRITE_UI_00_MENU_CURSOR_SQUARE + 2 + SPRITE_OFFSET_UI_00
        ldy #SelfModifiedSprite::TileId
        sta (SpritePtr), y
        lda #SPRITE_PAL_0
        ldy #SelfModifiedSprite::Attributes
        sta (SpritePtr), y
        lda widget_right_pos_x_pixel, x
        ldy #SelfModifiedSprite::PosX
        sta (SpritePtr), y
        lda widget_right_pos_y_pixel, x
        ldy #SelfModifiedSprite::PosY
        sta (SpritePtr), y

        perform_zpcm_inc
        rts
.endproc