; These are fixed on the screen, and I'm not going to waste effort
; trying to make them relocatable. Deal.
.macro widget_string_entry page_table, destination_str
        .addr widget_string_entry_init
        .addr page_table
        .addr destination_str
        .byte 0, 0, 0, 0
.endmacro

NAME_ENTRY_LEFT_TILE = 5
NAME_ENTRY_TOP_TILE  = 13

BUTTONS_LEFT_TILE = 22
PAGE_NAME_ROW = 13
DEL_ROW       = 15
CONFIRM_ROW   = 17

.proc draw_letter_grid
PagePtr := R0
NametableAddr := R2
AttributeAddr := R4
RowCounter := R6
ColCounter := R7
TOP_LEFT_NAMETABLE  = $5000 + (NAME_ENTRY_TOP_TILE * 32) + NAME_ENTRY_LEFT_TILE
TOP_LEFT_ATTRIBUTE = TOP_LEFT_NAMETABLE + $800

CurrentWidgetIndex := R20

widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6

        ldx CurrentWidgetIndex

        st16 NametableAddr, TOP_LEFT_NAMETABLE
        st16 AttributeAddr, TOP_LEFT_ATTRIBUTE
        lda #0
        sta RowCounter
row_loop:
        lda #0
        sta ColCounter
col_loop:
        ldy ColCounter
        lda (PagePtr), y
        pha
        lda ColCounter
        asl
        tay
        pla
        sta (NametableAddr), y
        lda ColCounter
        cmp widget_grid_pos_x, x
        bne no_highlight
        lda RowCounter
        cmp widget_grid_pos_y, x
        bne no_highlight
highlight:
        lda #(CHR_BANK_FONT_MARSHMALLOW | UI_PAL_BG1)
        jmp highlight_converge
no_highlight:
        lda #(CHR_BANK_FONT_MARSHMALLOW | UI_PAL_BG0)
highlight_converge:
        sta (AttributeAddr), y
        inc ColCounter
        lda ColCounter
        cmp #8
        bne col_loop
        add16b NametableAddr, #64
        add16b AttributeAddr, #64
        add16b PagePtr, #8
        inc RowCounter
        lda RowCounter
        cmp #6
        bne row_loop

        rts
.endproc

string_entry_del_str: .asciiz "Delete"
string_entry_accept_str: .asciiz "Accept"

.proc draw_controls
; FIXED_draw_string
NametableAddr := T0
AttributeAddr := T2
StringPtr := T4
TileBase := T6
PaletteIndex := T7

PageTablePtr := R2

CurrentWidgetIndex := R20

widget_page_table_low := widgets_data0
widget_page_table_high := widgets_data1
widget_target_string_low := widgets_data2
widget_target_string_high := widgets_data3
widget_current_page := widgets_data4
widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6

        ; Common setup for all string drawing to follow
        lda #CHR_BANK_FONT_MARSHMALLOW
        sta TileBase

        ; Draw the current page name

        ; If we are at the cursor position, then highlight this string
        ldy CurrentWidgetIndex
        lda widget_grid_pos_x, y
        cmp #8
        bne no_highlight_page_name
        lda widget_grid_pos_y, y
        cmp #0
        bne no_highlight_page_name
highlight_page_name:
        lda #UI_PAL_BG1
        jmp page_name_highlight_converge
no_highlight_page_name:
        lda #UI_PAL_BG0
page_name_highlight_converge:
        sta PaletteIndex

        ldy CurrentWidgetIndex
        lda widget_current_page, y
        lda widget_page_table_low, y
        sta PageTablePtr+0
        lda widget_page_table_high, y
        sta PageTablePtr+1
        lda widget_current_page, y
        asl ; each entry is two pointers == 4 bytes
        asl
        tay
        lda (PageTablePtr), y
        sta StringPtr+0
        iny
        lda (PageTablePtr), y
        sta StringPtr+1
        st16 NametableAddr, ($5000 + (PAGE_NAME_ROW * 32) + BUTTONS_LEFT_TILE)
        st16 AttributeAddr, ($5800 + (PAGE_NAME_ROW * 32) + BUTTONS_LEFT_TILE)
        jsr FIXED_draw_string
        ; Draw the delete string

        ; If we are at the cursor position, then highlight this string
        ldy CurrentWidgetIndex
        lda widget_grid_pos_x, y
        cmp #8
        bne no_highlight_delete
        lda widget_grid_pos_y, y
        cmp #1
        bne no_highlight_delete
highlight_delete:
        lda #UI_PAL_BG1
        jmp delete_highlight_converge
no_highlight_delete:
        lda #UI_PAL_BG0
delete_highlight_converge:
        sta PaletteIndex

        st16 StringPtr, string_entry_del_str
        st16 NametableAddr, ($5000 + (DEL_ROW * 32) + BUTTONS_LEFT_TILE)
        st16 AttributeAddr, ($5800 + (DEL_ROW * 32) + BUTTONS_LEFT_TILE)
        jsr FIXED_draw_string

        ; If we are at the cursor position, then highlight this string
        ldy CurrentWidgetIndex
        lda widget_grid_pos_x, y
        cmp #8
        bne no_highlight_accept
        lda widget_grid_pos_y, y
        cmp #2
        bne no_highlight_accept
highlight_accept:
        lda #UI_PAL_BG1
        jmp accept_highlight_converge
no_highlight_accept:
        lda #UI_PAL_BG0
accept_highlight_converge:
        sta PaletteIndex

        st16 StringPtr, string_entry_accept_str
        st16 NametableAddr, ($5000 + (CONFIRM_ROW * 32) + BUTTONS_LEFT_TILE)
        st16 AttributeAddr, ($5800 + (CONFIRM_ROW * 32) + BUTTONS_LEFT_TILE)
        jsr FIXED_draw_string
        rts
.endproc

.proc advance_page
PagePtr := R0
PageTablePtr := R2

CurrentWidgetIndex := R20

widget_page_table_low := widgets_data0
widget_page_table_high := widgets_data1
widget_target_string_low := widgets_data2
widget_target_string_high := widgets_data3
widget_current_page := widgets_data4

        ldy CurrentWidgetIndex
        ; Increment the page number
        lda widget_current_page, y
        clc
        adc #1
        sta widget_current_page, y
        ; Read the new entry from the page table
        lda widget_page_table_low, y
        sta PageTablePtr+0
        lda widget_page_table_high, y
        sta PageTablePtr+1
        lda widget_current_page, y
        asl ; each entry is two pointers == 4 bytes
        asl
        tay
        ; If it is $0000, reset the page number to 0
        lda (PageTablePtr), y
        iny
        ora (PageTablePtr), y
        bne page_in_range
        lda #0
        ldy CurrentWidgetIndex
        sta widget_current_page, y
page_in_range:
        ; draw the letter grid and refresh the controls
        jsr draw_current_page
        jsr draw_controls
        ; (hook this up to SELECT)
        rts
.endproc

.proc draw_current_string
        ; do just that. we should have a fancy flashing cursor at the end? (yes!)
.endproc

.proc add_to_string
        ; First, check the string length. If it's already 15 or higher, buzz and fail.
        ; Add this glyph to the end of the pointed-at string, followed by a $0 byte
        ; draw the string again
.endproc

.proc delete_from_string
        ; First, check the string length. If it is already 0, buzz and fail.
        ; Remove the glyph at the end of the pointed-at string, replacing it with a $0 byte
        ; draw the string again
.endproc

.proc draw_current_page
PagePtr := R0
PageTablePtr := R2

CurrentWidgetIndex := R20

widget_page_table_low := widgets_data0
widget_page_table_high := widgets_data1
widget_current_page := widgets_data4

        ldy CurrentWidgetIndex
        lda widget_page_table_low, y
        sta PageTablePtr+0
        lda widget_page_table_high, y
        sta PageTablePtr+1
        lda widget_current_page, y
        asl ; each entry is two pointers == 4 bytes
        asl
        clc
        adc #2 ; grab the second pointer, to the actual letter grid
        tay
        lda (PageTablePtr), y
        sta PagePtr+0
        iny
        lda (PageTablePtr), y
        sta PagePtr+1
        jsr draw_letter_grid
        rts
.endproc

.proc move_cursor_right
CurrentWidgetIndex := R20

widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6        

        ldy CurrentWidgetIndex
        lda widget_grid_pos_x, y
        cmp #8
        beq cancel_move
        clc
        adc #1
        sta widget_grid_pos_x, y
        cmp #8
        bne position_is_fine
        ; if we are further down than the "accept" button,
        ; move up to that spot
        lda widget_grid_pos_y, y
        cmp #2
        bcc position_is_fine
        lda #2
        sta widget_grid_pos_y, y
position_is_fine:
        jsr draw_current_page
        jsr draw_controls
cancel_move:
        rts
.endproc

.proc move_cursor_left
CurrentWidgetIndex := R20

widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6        

        ldy CurrentWidgetIndex
        lda widget_grid_pos_x, y
        beq cancel_move
        sec
        sbc #1
        sta widget_grid_pos_x, y
        jsr draw_current_page
        jsr draw_controls
cancel_move:
        rts
.endproc

.proc move_cursor_up
CurrentWidgetIndex := R20

widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6        

        ldy CurrentWidgetIndex
        lda widget_grid_pos_y, y
        beq cancel_move
        sec
        sbc #1
        sta widget_grid_pos_y, y
        jsr draw_current_page
        jsr draw_controls
cancel_move:
        rts
.endproc

.proc move_cursor_down
CurrentWidgetIndex := R20

widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6        

        ldy CurrentWidgetIndex
        ; always cancel if we are on the bottom row
        lda widget_grid_pos_y, y
        cmp #5
        beq cancel_move
        ; if we are on the rightmost column...
        lda widget_grid_pos_x, y
        cmp #8
        bne allow_move
        ; then only allow up to the lowest button...
        lda widget_grid_pos_y, y
        cmp #2
        beq cancel_move
allow_move:
        lda widget_grid_pos_y, y
        clc
        adc #1
        sta widget_grid_pos_y, y
        jsr draw_current_page
        jsr draw_controls
cancel_move:
        rts
.endproc

.proc widget_string_entry_init
CurrentWidgetIndex := R20

widget_page_table_low := widgets_data0
widget_page_table_high := widgets_data1
widget_target_string_low := widgets_data2
widget_target_string_high := widgets_data3
widget_current_page := widgets_data4
widget_grid_pos_x   := widgets_data5
widget_grid_pos_y   := widgets_data6


        ldy CurrentWidgetIndex
        lda #1
        sta widget_current_page, y
        lda #0
        sta widget_grid_pos_x, y
        sta widget_grid_pos_y, y

        jsr draw_current_page
        jsr draw_controls

        ldy CurrentWidgetIndex
        set_widget_state_y widget_string_entry_update
        rts
.endproc

.proc widget_string_entry_update

check_left:
        lda #(KEY_LEFT)
        bit ButtonsDown
        beq left_not_pressed
        jsr move_cursor_left
left_not_pressed:

check_right:
        lda #(KEY_RIGHT)
        bit ButtonsDown
        beq right_not_pressed
        jsr move_cursor_right
right_not_pressed:

check_up:
        lda #(KEY_UP)
        bit ButtonsDown
        beq up_not_pressed
        jsr move_cursor_up
up_not_pressed:

check_down:
        lda #(KEY_DOWN)
        bit ButtonsDown
        beq down_not_pressed
        jsr move_cursor_down
down_not_pressed:

check_select:
        lda #(KEY_SELECT)
        bit ButtonsDown
        beq select_not_pressed
        jsr advance_page
select_not_pressed:
        rts
.endproc