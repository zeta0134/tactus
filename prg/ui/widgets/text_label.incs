.macro widget_text_label text_string, tile_x, tile_y
    .addr widget_text_label::FAR_widget_text_label_init
    .byte <.bank(widget_text_label::FAR_widget_text_label_init)
    .byte tile_x, tile_y
    .addr text_string
    .byte 0, 0, 0, UI_PAL_BG0
.endmacro

.macro widget_text_label_attr text_string, tile_x, tile_y, text_attr
    .addr widget_text_label::FAR_widget_text_label_init
    .byte <.bank(widget_text_label::FAR_widget_text_label_init)
    .byte tile_x, tile_y
    .addr text_string
    .byte 0, 0, 0, text_attr
.endmacro

.macro widget_text_label_localized text_string, tile_x, tile_y
    .addr widget_text_label::FAR_widget_text_label_init_localized
    .byte <.bank(widget_text_label::FAR_widget_text_label_init_localized)
    .byte tile_x, tile_y
    .addr text_string
    .byte 0, 0, 0, 0
.endmacro

.scope widget_text_label

.segment "CODE_UI_WIDGETS_0"

.proc FAR_widget_text_label_init_localized
CurrentWidgetIndex := R20

; rename the data labels to something more readable
widget_tile_x := widgets_data0
widget_tile_y := widgets_data1
widget_text_string_low := widgets_data2
widget_text_string_high := widgets_data3

; arguments to string drawing functions
NametableAddr := T0
AttributeAddr := T2
TileX := T4
TileY := T5
StringPtr := T4
        ldy CurrentWidgetIndex
        lda widget_tile_x, y
        sta TileX
        lda widget_tile_y, y
        sta TileY
        st16 NametableAddr, $5000
        st16 AttributeAddr, $5800
        far_call FAR_nametable_from_coordinates
        perform_zpcm_inc
        ldy CurrentWidgetIndex
        lda widget_text_string_low, y
        sta StringPtr+0
        lda widget_text_string_high, y
        sta StringPtr+1    
        near_call FAR_draw_ui_string

        ldy CurrentWidgetIndex
        set_widget_state_y FAR_widget_no_behavior

        rts
.endproc

.proc FAR_widget_text_label_init
CurrentWidgetIndex := R20

; rename the data labels to something more readable
widget_tile_x := widgets_data0
widget_tile_y := widgets_data1
widget_text_string_low := widgets_data2
widget_text_string_high := widgets_data3

; arguments to string drawing functions
NametableAddr := T0
AttributeAddr := T2
TileX := T4
TileY := T5
StringPtr := T4
TileBase := T6
PaletteIndex := T7
        near_call FAR_draw_widget_label_pal

        ldy CurrentWidgetIndex
        set_widget_state_y FAR_widget_no_behavior

        rts
.endproc

.endscope ; widget_text_label
