.macro widget_file_select_box file_index, tile_x, tile_y
        .addr widget_file_select_box::FAR_widget_file_select_box_init
        .byte <.bank(widget_file_select_box::FAR_widget_file_select_box_init)
        .byte tile_x, tile_y
        .addr file_index
        .byte 0, 0, 0, 0
.endmacro

.scope widget_file_select_box

CORNER_TL_LIGHT   = $0E
CORNER_TR_LIGHT   = $0F
CORNER_BL_LIGHT   = $1E
CORNER_BR_LIGHT   = $1F
EDGE_LEFT_LIGHT   = $0C
EDGE_RIGHT_LIGHT  = $1C
EDGE_TOP_LIGHT    = $0D
EDGE_BOTTOM_LIGHT = $1D

CORNER_TL_DARK = $0A
CORNER_TR_DARK = $0B
CORNER_BL_DARK = $1A
CORNER_BR_DARK = $1B
EDGE_LEFT_DARK   = $0C
EDGE_RIGHT_DARK  = $1C
EDGE_TOP_DARK    = $0D
EDGE_BOTTOM_DARK = $1D

TOP_SHADOW_DARK = $14
TOP_SHADOW_LIGHT = $15
BOTTOM_SHADOW_DARK = $16
BOTTOM_SHADOW_LIGHT = $17

RIGHT_EDGE_SHADOW_DARK = $04
RIGHT_EDGE_SHADOW_LIGHT = $05
BOTTOM_EDGE_SHADOW_DARK = $12
BOTTOM_EDGE_SHADOW_LIGHT = $13

SHADOW_CORNER_LIGHT = $11
SHADOW_CORNER_DARK = $10

.segment "DATA_UI_LAYOUTS"

new_file_str:    localized_color_str UI_PAL_BG1, file_select_new_file
in_progress_str: localized_color_str UI_PAL_BG1, file_select_run_in_progress

.segment "CODE_UI_WIDGETS_1"

.proc FAR_compute_top_left_corner_addr
Top := R0
Left := R1
Width := R2
Height := R3
NametableAddr := R4
AttributeAddr := R6
        perform_zpcm_inc
        ; compute starting address for the top-left corner
        lda Top
        sta NametableAddr+0
        lda #0
        sta NametableAddr+1
        .repeat 5
        asl NametableAddr+0
        rol NametableAddr+1
        .endrepeat
        lda Left
        clc
        adc NametableAddr+0
        sta NametableAddr+0
        lda #$50
        adc NametableAddr+1
        sta NametableAddr+1
        lda NametableAddr+0
        sta AttributeAddr+0
        lda NametableAddr+1
        clc
        adc #$08
        sta AttributeAddr+1
        perform_zpcm_inc
        rts
.endproc

.proc FAR_draw_box_outline_light
ShadowAttr := R9
BoxOutlineAttr := R10
        lda #(CHR_BANK_0_FONT_MARSHMALLOW | UI_PAL_BG3)
        sta ShadowAttr
        lda #(CHR_BANK_0_FONT_MARSHMALLOW | UI_PAL_BG2)
        sta BoxOutlineAttr
        jmp _draw_box_outline_common
.endproc

.proc FAR_draw_box_outline_dark
ShadowAttr := R9
BoxOutlineAttr := R10
        lda #(CHR_BANK_0_FONT_MARSHMALLOW | UI_PAL_BG3)
        sta ShadowAttr
        lda #(CHR_BANK_0_FONT_MARSHMALLOW_DARK | UI_PAL_BG2)
        sta BoxOutlineAttr
        jmp _draw_box_outline_common
.endproc

.proc _draw_box_outline_common
Top := R0
Left := R1
Width := R2
Height := R3
NametableAddr := R4
AttributeAddr := R6
RowCounter := R8
ShadowAttr := R9
BoxOutlineAttr := R10
        near_call FAR_compute_top_left_corner_addr

        ; top row
        ldy #0
        lda #CORNER_TL_LIGHT
        sta (NametableAddr), y
        lda BoxOutlineAttr
        sta (AttributeAddr), y
        iny
top_col_loop:
        perform_zpcm_inc
        lda #EDGE_TOP_LIGHT
        sta (NametableAddr), y
        lda BoxOutlineAttr
        sta (AttributeAddr), y
        iny
        cpy Width
        bne top_col_loop
        lda #CORNER_TR_LIGHT
        sta (NametableAddr), y
        lda BoxOutlineAttr
        sta (AttributeAddr), y

        ; middle rows
        lda Height
        sec
        sbc #2
        sta RowCounter
middle_row_loop:
        perform_zpcm_inc
        add16b NametableAddr, #32
        add16b AttributeAddr, #32
        ldy #0
        lda #EDGE_LEFT_LIGHT
        sta (NametableAddr), y
        lda BoxOutlineAttr
        sta (AttributeAddr), y
        ldy Width
        lda #EDGE_RIGHT_LIGHT
        sta (NametableAddr), y
        lda BoxOutlineAttr
        sta (AttributeAddr), y
        dec RowCounter
        bne middle_row_loop

        add16b NametableAddr, #32
        add16b AttributeAddr, #32

        ; bottom row
        ldy #0
        lda #CORNER_BL_LIGHT
        sta (NametableAddr), y
        lda BoxOutlineAttr
        sta (AttributeAddr), y
        iny
bottom_col_loop:
        perform_zpcm_inc
        lda #EDGE_BOTTOM_LIGHT
        sta (NametableAddr), y
        lda BoxOutlineAttr
        sta (AttributeAddr), y
        iny
        cpy Width
        bne bottom_col_loop
        lda #CORNER_BR_LIGHT
        sta (NametableAddr), y
        lda BoxOutlineAttr
        sta (AttributeAddr), y

        perform_zpcm_inc
        rts
.endproc

.proc FAR_draw_box_shadow
Top := R0
Left := R1
Width := R2
Height := R3
NametableAddr := R4
AttributeAddr := R6
RowCounter := R8
ShadowAttr := R9
BoxOutlineAttr := R10
        near_call FAR_compute_top_left_corner_addr   
        ; top row
        ldy Width
        iny
        ; for the shadow we need to know what's underneath us
        lda (NametableAddr), y
        cmp #DARK_SQUARE_TILE
        beq dark_top_shadow
light_top_shadow:
        lda #TOP_SHADOW_LIGHT
        jmp done_picking_top_shadow
dark_top_shadow:
        lda #TOP_SHADOW_DARK
done_picking_top_shadow:
        sta (NametableAddr), y
        lda ShadowAttr
        sta (AttributeAddr), y

        ; middle (and bottom) rows
        lda Height
        sec
        sbc #1
        sta RowCounter
middle_row_loop:
        perform_zpcm_inc
        add16b NametableAddr, #32
        add16b AttributeAddr, #32
        ldy Width
        iny
        lda (NametableAddr), y
        cmp #DARK_SQUARE_TILE
        beq dark_side_shadow
light_side_shadow:
        lda #RIGHT_EDGE_SHADOW_LIGHT
        jmp done_picking_side_shadow
dark_side_shadow:
        lda #RIGHT_EDGE_SHADOW_DARK
done_picking_side_shadow:
        sta (NametableAddr), y
        lda ShadowAttr
        sta (AttributeAddr), y
        dec RowCounter
        bne middle_row_loop

        add16b NametableAddr, #32
        add16b AttributeAddr, #32

        ; bottom shadow, which is significantly more involved T_T
        ldy #0
        lda (NametableAddr), y
        cmp #DARK_SQUARE_TILE
        beq bottom_dark_shadow
bottom_light_shadow:
        lda #BOTTOM_SHADOW_LIGHT
        jmp done_picking_bottom_shadow
bottom_dark_shadow:
        lda #BOTTOM_SHADOW_DARK
done_picking_bottom_shadow:
        sta (NametableAddr), y
        lda ShadowAttr
        sta (AttributeAddr), y
shadow_loop:
        perform_zpcm_inc
        iny ; increment at the _top_ of the loop, since we want to extend 1 past the edge this time
        lda (NametableAddr), y
        cmp #DARK_SQUARE_TILE
        beq bottom_edge_dark_shadow
bottom_edge_light_shadow:
        lda #BOTTOM_EDGE_SHADOW_LIGHT
        jmp done_picking_bottom_edge_shadow
bottom_edge_dark_shadow:
        lda #BOTTOM_EDGE_SHADOW_DARK
done_picking_bottom_edge_shadow:
        sta (NametableAddr), y
        lda ShadowAttr
        sta (AttributeAddr), y
        cpy Width
        bne shadow_loop
        ; finally, the bottom-right corner
        iny
        lda (NametableAddr), y
        cmp #DARK_SQUARE_TILE
        beq bottom_corner_dark_shadow
bottom_corner_light_shadow:
        lda #SHADOW_CORNER_LIGHT
        jmp done_picking_bottom_corner_shadow
bottom_corner_dark_shadow:
        lda #SHADOW_CORNER_DARK
done_picking_bottom_corner_shadow:
        sta (NametableAddr), y
        lda ShadowAttr
        sta (AttributeAddr), y
        perform_zpcm_inc

        rts
.endproc

.proc FAR_draw_box_fill
Top := R0
Left := R1
Width := R2
Height := R3
NametableAddr := R4
AttributeAddr := R6
RowCounter := R8
        near_call FAR_compute_top_left_corner_addr
        add16b NametableAddr, #32
        add16b AttributeAddr, #32

        ; loop over every middle row
        lda Height
        sec
        sbc #2
        sta RowCounter
row_loop:
        ; loop over every column in the middle row
        ldy #1
col_loop:
        perform_zpcm_inc
        ; set that tile to blank
        lda #0
        sta (NametableAddr), y
        lda #CHR_BANK_0_FONT_MARSHMALLOW ; palette doesn't matter here
        sta (AttributeAddr), y
        iny
        cpy Width
        bne col_loop
        ; move to the next row and repeat
        add16b NametableAddr, #32
        add16b AttributeAddr, #32
        dec RowCounter
        bne row_loop
        rts
.endproc

; file index in A
.proc FAR_prepare_file_pointer
FilePtr := R0
        cmp #0
        beq file_0
        cmp #1
        beq file_1
        cmp #2    
        beq file_2
        ; PANIC! (we should crash)
        ; instead, fall through to file 0
file_0:
        st16 FilePtr, (current_block + SaveBlock::SaveSlot1)
        rts
file_1:
        st16 FilePtr, (current_block + SaveBlock::SaveSlot2)
        rts
file_2:
        st16 FilePtr, (current_block + SaveBlock::SaveSlot3)
        rts
.endproc

player_palette_offset_by_file_id:
        .byte 0, 8, 12
player_palette_by_file_id:
        .byte SPRITE_PAL_0, SPRITE_PAL_2, SPRITE_PAL_3

.proc FAR_draw_file_contents
; FIXED_draw_string
NametableAddr := T0
AttributeAddr := T2
TileX := T4
TileY := T5
StringPtr := T4
TileBase := T6
PaletteIndex := T7

FilePtr := R0
FileNameTilePtr := R2
FileNameAttrPtr := R4
CurrentWidgetIndex := R20
    
widget_tile_x := widgets_data0
widget_tile_y := widgets_data1
widget_file_index := widgets_data2
widget_sprite_index := widgets_data4

        st16 NametableAddr, $5000
        st16 AttributeAddr, $5800

        ldy CurrentWidgetIndex
        lda widget_tile_x, y
        clc
        adc #6
        sta TileX
        lda widget_tile_y, y
        clc
        adc #1
        sta TileY
        far_call FAR_nametable_from_coordinates

        perform_zpcm_inc

        ldy CurrentWidgetIndex
        lda widget_file_index, y
        near_call FAR_prepare_file_pointer
        far_call FAR_is_new_file
        cmp #FILE_NEW
        jeq draw_new_file

draw_existing_file:
        mov16 FileNameTilePtr, FilePtr
        add16w FileNameTilePtr, #SaveFile::PlayerNameTiles
        mov16 FileNameAttrPtr, FilePtr
        add16w FileNameAttrPtr, #SaveFile::PlayerNameFont
        ldy #0
tile_loop:
        lda (FileNameAttrPtr), y
        beq done_drawing_filename
        ora #UI_PAL_BG1
        sta (AttributeAddr), y
        lda (FileNameTilePtr), y
        sta (NametableAddr), y
        iny
        ; safety
        cpy #15
        bne tile_loop
done_drawing_filename:

        ; Draw the second row of details below the filename. TODO: make this much fancier
        add16b NametableAddr, #32
        add16b AttributeAddr, #32
        ldy #SaveFile::RunFlags
        lda (FilePtr), y
        and #RUN_FLAGS_SUSPENDED
        bne run_in_progress
no_run_in_progress:
        ; TODO: draw tropies and other achievements
        ; Also do we need to clear out the area?
        jmp done_with_second_row
run_in_progress:
        st16 StringPtr, in_progress_str
        far_call FAR_draw_ui_string
done_with_second_row:

        ; This file exists! Oh boy. Let's work out the colors then
        ldy CurrentWidgetIndex
        lda widget_file_index, y
        far_call FAR_compute_colors_for_save_slot
        ; use our file index as an offset into the palette data
        ldy CurrentWidgetIndex
        lda widget_file_index, y
        tax
        lda player_palette_offset_by_file_id, x
        tax
        ; and transfer!
        lda player_palettes_phones+PLAYER_PALETTE_NORMAL
        sta PlayfieldObjPal0+0, x
        lda player_palettes_pajamas+PLAYER_PALETTE_NORMAL
        sta PlayfieldObjPal0+1, x
        lda player_palettes_pigment+PLAYER_PALETTE_NORMAL
        sta PlayfieldObjPal0+2, x
        lda #1
        sta StagingObjPaletteDirty
        ; Now move the sprite into position
        ldy CurrentWidgetIndex
        lda widgets_cursor_pos_y, y
        ldx widget_sprite_index, y
        sta sprite_table + MetaSpriteState::PositionY, x
        perform_zpcm_inc

        rts

draw_new_file:
        st16 StringPtr, new_file_str
        far_call FAR_draw_ui_string

        ; new files won't display a player sprite, so just move it offscreen
        ldy CurrentWidgetIndex
        ldx widget_sprite_index, y
        lda #$F0
        sta sprite_table + MetaSpriteState::PositionY, x
        perform_zpcm_inc

        rts
.endproc

.proc FAR_widget_file_select_box_init
MetaSpriteIndex := R0

Top := R0
Left := R1
Width := R2
Height := R3

CurrentWidgetIndex := R20
        
widget_tile_x := widgets_data0
widget_tile_y := widgets_data1
widget_file_index := widgets_data2
widget_current_hover_state := widgets_data3
widget_sprite_index := widgets_data4

        ldy CurrentWidgetIndex
        lda widget_tile_x, y
        sta Left
        lda widget_tile_y, y
        sta Top
        lda #23
        sta Width
        lda #4
        sta Height
        near_call FAR_draw_box_outline_dark
        near_call FAR_draw_box_fill
        near_call FAR_draw_box_shadow

        ; set our cursor position based on the leftmost tile position
        ; TODO: offset this as required!
        ldy CurrentWidgetIndex
        lda widget_tile_x, y
        asl ; x2
        asl ; x4
        asl ; x8
        clc
        adc #0
        sta widgets_cursor_pos_x, y
        lda widget_tile_y, y
        asl ; x2
        asl ; x4
        asl ; x8
        clc
        adc #8
        sta widgets_cursor_pos_y, y

        ; flag this widget as active for cursor navigation purposes
        ldy CurrentWidgetIndex
        lda widgets_state_flags, y
        ora #WIDGET_STATE_NAVIGABLE
        sta widgets_state_flags, y

        ; we just drew ourselves in unhovered mode, so set that flag
        lda #0
        sta widget_current_hover_state, y

        ; spawn in a sprite!
        far_call FAR_find_unused_sprite
        lda MetaSpriteIndex
        ldy CurrentWidgetIndex
        sta widget_sprite_index, y


        ldx widget_sprite_index, y
        lda #(SPRITE_ACTIVE | SPRITE_HORIZ_FLIP | SPRITE_PAL_1)
        sta sprite_table + MetaSpriteState::BehaviorFlags, x
        lda #$FF
        sta sprite_table + MetaSpriteState::LifetimeBeats, x
        ; Use the cursor position but +16
        lda widgets_cursor_pos_x, y
        clc
        adc #24
        sta sprite_table + MetaSpriteState::PositionX, x
        lda #$F0 ; offscreen for now 
        sta sprite_table + MetaSpriteState::PositionY, x
        set_ui_00_sprite_x SPRITE_UI_00_PLAYER

        ; populate this box's contents (which manipulates that sprite
        ; up there)
        near_call FAR_draw_file_contents

        ldy CurrentWidgetIndex
        set_widget_state_y FAR_widget_file_select_box_update
        rts
.endproc

.proc FAR_redraw_border_if_needed
Top := R0
Left := R1
Width := R2
Height := R3

CurrentWidgetIndex := R20

widget_tile_x := widgets_data0
widget_tile_y := widgets_data1
widget_file_index := widgets_data2
widget_current_hover_state := widgets_data3
widget_sprite_index := widgets_data4
    
        ; are we currently hovered?
        ldy CurrentWidgetIndex
        lda widgets_state_flags, y
        and #WIDGET_STATE_HOVER
        bne we_are_hovered
we_are_not_hovered:
        ; are we currently drawn as hovered?
        lda widget_current_hover_state, y
        beq nothing_to_do
        ; draw ourselves unhovered!
        ldy CurrentWidgetIndex
        lda widget_tile_x, y
        sta Left
        lda widget_tile_y, y
        sta Top
        lda #23
        sta Width
        lda #4
        sta Height
        near_call FAR_draw_box_outline_dark
        ; and set accordingly
        ldy CurrentWidgetIndex
        lda #0
        sta widget_current_hover_state, y

        lda #(SPRITE_ACTIVE | SPRITE_HORIZ_FLIP | SPRITE_PAL_1) ; use the cursor palette
        ldx widget_sprite_index, y
        sta sprite_table + MetaSpriteState::BehaviorFlags, x

        rts
we_are_hovered:
        ; same deal but the other way around
        lda widget_current_hover_state, y
        bne nothing_to_do
        ; draw ourselves hovered!
        ldy CurrentWidgetIndex
        lda widget_tile_x, y
        sta Left
        lda widget_tile_y, y
        sta Top
        lda #23
        sta Width
        lda #4
        sta Height
        near_call FAR_draw_box_outline_light
        ; and set accordingly
        ldy CurrentWidgetIndex
        lda #1
        sta widget_current_hover_state, y

        lda #(SPRITE_ACTIVE | SPRITE_HORIZ_FLIP)
        ldx widget_file_index, y
        ora player_palette_by_file_id, x ; use the real sprite palette
        ldx widget_sprite_index, y
        sta sprite_table + MetaSpriteState::BehaviorFlags, x

        rts
nothing_to_do:
        rts
.endproc

.proc FAR_widget_file_select_box_update
CurrentWidgetIndex := R20

; rename the data labels to something more readable
widget_file_index := widgets_data2

        near_call FAR_redraw_border_if_needed

        ; if we aren't even hovered, do nothing
        ldy CurrentWidgetIndex
        lda widgets_state_flags, y
        and #WIDGET_STATE_HOVER
        bne check_for_action_input
        rts
check_for_action_input:
        lda #(KEY_A | KEY_START)
        and ButtonsDown
        beq do_nothing

        far_call FAR_with_file_perform_action

do_nothing:
        rts
.endproc

.proc FAR_widget_file_select_box_refresh
Top := R0
Left := R1
Width := R2
Height := R3

CurrentWidgetIndex := R20

widget_tile_x := widgets_data0
widget_tile_y := widgets_data1

        ; clear this box's contents
        ldy CurrentWidgetIndex
        lda widget_tile_x, y
        sta Left
        lda widget_tile_y, y
        sta Top
        lda #23
        sta Width
        lda #4
        sta Height
        near_call FAR_draw_box_fill

        ; populate this box's contents
        near_call FAR_draw_file_contents

        ldy CurrentWidgetIndex
        set_widget_state_y FAR_widget_file_select_box_update
        rts
.endproc

.endscope ; widget_file_select_box
