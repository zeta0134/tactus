; ======================================================================
;                         Layouts and Widgets
; ======================================================================


.macro widget_options_battlefield
    .addr options_battlefield_init
    .byte 0, 0, 0, 0, 0, 0, 0, 0
.endmacro

.segment "DATA_UI_LAYOUTS"

options_ui_layout:
        widget_controller options_controller_init
        widget_cursor
        widget_text_label game_options_str, 2, 13
        widget_text_options game_mode_str,      game_mode_types,      {current_save + SaveFile::OptionRhythmMode},      4, 15
        widget_text_options disco_floor_str,    disco_types,          {current_save + SaveFile::OptionDiscoFloor},    4, 16
        widget_text_label player_options_str, 2, 18
        widget_text_options player_palette_preset_str, player_palette_preset_types, {current_save + SaveFile::PlayerPalettePreset}, 4, 20
        widget_numeric_slider player_palette_outfit_str, 15, 39, {current_save + SaveFile::PlayerPalettePajamasIndex}, 4, 22
        widget_numeric_viewer {current_save + SaveFile::PlayerPalettePajamasIndex}, 11, 22
        widget_numeric_slider player_palette_shoes_str,  15, 52, {current_save + SaveFile::PlayerPalettePhonesIndex},  4, 23
        widget_numeric_viewer {current_save + SaveFile::PlayerPalettePhonesIndex},  11, 23
        widget_numeric_slider player_palette_face_str,   15, 39, {current_save + SaveFile::PlayerPalettePigmentIndex}, 4, 24
        widget_numeric_viewer {current_save + SaveFile::PlayerPalettePigmentIndex}, 11, 24
        widget_text_button save_options_str, save_and_return_to_file_details, 9, 26
        widget_options_battlefield
        widget_controller apply_fancy_color_shenanigans
        .addr $0000 ; end of list

PRESET_PERSONALIZED_VALUE = 0
; Used for manual tweaking of the values
OPTIONS_CURSOR_INDEX = 1
PRESET_FIELD_INDEX = 6
PALETTE_SLIDER_INDEX_1 = 7
PALETTE_SLIDER_INDEX_2 = 9
PALETTE_SLIDER_INDEX_3 = 11
OPTIONS_SAVE_BUTTON_INDEX = 13

game_options_str:   .asciiz "GAMEPLAY OPTIONS"
game_mode_str:      .asciiz "Rhythm "
disco_floor_str:    .asciiz "Floor  "
player_options_str: .asciiz "PLAYER PALETTE"
player_palette_preset_str: .asciiz "Preset  "
player_palette_outfit_str: .asciiz "Pajamas    "
player_palette_shoes_str:  .asciiz "Phones     "
player_palette_face_str:   .asciiz "Pigment    "
save_options_str:  .asciiz "SAVE AND EXIT"

disco_types:
        .byte 6 ; length of option set
        .addr disco_option_0_str
        .addr disco_option_1_str
        .addr disco_option_2_str
        .addr disco_option_3_str
        .addr disco_option_4_str
        .addr disco_option_5_str

disco_option_0_str: .asciiz "INSTANT SQUARES"
disco_option_1_str: .asciiz "FROZEN SQUARES"
disco_option_2_str: .asciiz "INSTANT OUTLINES"
disco_option_3_str: .asciiz "FROZEN OUTLINES"
disco_option_4_str: .asciiz "JUST GROOVEMENT"
disco_option_5_str: .asciiz "NO MOTION"

player_palette_preset_types:
        .byte 6 ; selectable length of option set
        .addr player_palette_preset_option_custom_str
        .addr player_palette_preset_option_1_str
        .addr player_palette_preset_option_2_str
        .addr player_palette_preset_option_3_str
        .addr player_palette_preset_option_4_str
        .addr player_palette_preset_option_5_str

player_palette_preset_option_custom_str: .asciiz "PERSONALIZED"
player_palette_preset_option_1_str:      .asciiz "PEONY"
player_palette_preset_option_2_str:      .asciiz "PERIWINKLE"
player_palette_preset_option_3_str:      .asciiz "PETUNIA"
player_palette_preset_option_4_str:      .asciiz "PROTEA"
player_palette_preset_option_5_str:      .asciiz "PASSION"

game_mode_types:
        .byte 3 ; length of option set
        .addr game_mode_standard_str
        .addr game_mode_patient_str
        .addr game_mode_doubletime_str

game_mode_standard_str:   .asciiz "STANDARD"
game_mode_patient_str:    .asciiz "PATIENT"
game_mode_doubletime_str: .asciiz "DOUBLETIME"

options_battlefield_bg_palette:
        .incbin "../art/dank_cave.pal"
options_obj_palette:
        .incbin "../art/options_sprite_palette.pal"

; ======================================================================
;                       Screen Specific Logic
; ======================================================================

.segment "CODE_UI_UTIL"

.proc FAR_options_controller_init
MetaSpriteIndex := R0
CurrentWidgetIndex := R20
widget_color_top_metasprite_index := widgets_data0
widget_color_bottom_metasprite_index := widgets_data1
        perform_zpcm_inc
        ; Play the options track on the options screen
        lda #TRACK_OPTIONS
        ldy #TRACK_VARIANT_NORMAL
        jsr play_track

        ; the options screen DOES use extended attributes, so set that up
        lda #0
        sta LeftNametableBank
        sta RightNametableBank
        lda #(NT_FPGA_RAM | NT_EXT_BANK_2 | NT_EXT_BG_AT)
        sta LeftNametableAttr
        sta RightNametableAttr

        ; Initialize with a totally blank nametable
        far_call FAR_draw_blank_nametable

        ; Now we need to zero out the first 6 metatiles, for the pseudo background
        ; to use the correct torchlight (as we aren't actually doing torchlight)
        ; (I guess we could load in a static torchlight pattern if we really wanted to?)
        lda #0
        ldy #0
torchlight_loop_a:
        perform_zpcm_inc
        sta $5800, y
        iny
        bne torchlight_loop_a
torchlight_loop_b:
        perform_zpcm_inc
        sta $5900, y
        iny
        cpy #128
        bne torchlight_loop_b

        ; we need a fancy mid-frame split to switch from the battlefield preview
        ; to the hud set instead
        set_raster_effect_safely #RASTER_EFFECT_OPTIONS, #RASTER_FINALIZER_NONE, #0
        set_raster_playback_speed #1, #0

        ; Get the file select palettes loaded in
        ; TODO: use file select palette here!
        ldy #0
bg_loop:
        perform_zpcm_inc
        lda options_battlefield_bg_palette, y
        sta IncomingHwPalette, y
        iny
        cpy #16
        bne bg_loop

        far_call FAR_set_bg_target_palette_from_hw
        far_call FAR_set_bg_current_palette_from_target

        ldy #0
obj_loop:
        perform_zpcm_inc        
        lda options_obj_palette, y
        sta IncomingHwPalette, y
        iny
        cpy #16
        bne obj_loop

        far_call FAR_set_obj_palette_from_hw

        ; Allocate two delightful sprites for the color slider area
        far_call FAR_find_unused_sprite
        lda MetaSpriteIndex
        ldy CurrentWidgetIndex
        sta widget_color_top_metasprite_index, y
        ; And set their properties
        ldy CurrentWidgetIndex
        ldx widget_color_top_metasprite_index, y
        lda #(SPRITE_ACTIVE | SPRITE_PAL_0)
        sta sprite_table + MetaSpriteState::BehaviorFlags, x
        lda #$FF
        sta sprite_table + MetaSpriteState::LifetimeBeats, x
        lda #113
        sta sprite_table + MetaSpriteState::PositionX, x
        lda #168
        sta sprite_table + MetaSpriteState::PositionY, x
        set_ui_00_sprite_x SPRITE_UI_00_PLAIN_SQUARES_LEFT

        far_call FAR_find_unused_sprite
        lda MetaSpriteIndex
        ldy CurrentWidgetIndex
        sta widget_color_bottom_metasprite_index, y
        ; And set their properties
        ldy CurrentWidgetIndex
        ldx widget_color_bottom_metasprite_index, y
        lda #(SPRITE_ACTIVE | SPRITE_PAL_0)
        sta sprite_table + MetaSpriteState::BehaviorFlags, x
        lda #$FF
        sta sprite_table + MetaSpriteState::LifetimeBeats, x
        lda #113
        sta sprite_table + MetaSpriteState::PositionX, x
        lda #184
        sta sprite_table + MetaSpriteState::PositionY, x
        set_ui_00_sprite_x SPRITE_UI_00_PLAIN_SQUARES_RIGHT

        lda #BRIGHTNESS_FULLY_DARK
        jsr set_brightness
        lda #BRIGHTNESS_NORMAL
        sta TargetBrightness

        ldy CurrentWidgetIndex
        set_widget_state_y options_controller_update
        rts
.endproc

        .segment "CODE_UI_WIDGETS"

.proc options_controller_init
        far_call FAR_options_controller_init
        rts
.endproc

.proc options_controller_update
widget_cursor_nav_index := widgets_data1

        ; We need the playfield to start in CHR 1M mode, to display
        ; the battlefield. We use a raster effect to switch back to
        ; 0M mode using the HUD. This is the only screen that needs this,
        ; which is why we do a simple bodge here.
        lda PlayfieldBgHighBank
        clc
        adc #4
        sta PlayfieldBgHighBank

        lda #KEY_B
        and ButtonsDown
        beq stay_here
        jsr save_and_return_to_file_details
        rts
stay_here:

        lda #KEY_START
        and ButtonsDown
        beq leave_that_cursor_alone

        ldy #OPTIONS_CURSOR_INDEX
        lda #OPTIONS_SAVE_BUTTON_INDEX
        sta widget_cursor_nav_index, y

        queue_sfx_pulse2 sfx_move_cursor

leave_that_cursor_alone:
        rts
.endproc

.proc save_and_return_to_file_details
        far_call FAR_save_current_file
        jsr go_to_file_details
        rts
.endproc

OPTIONS_DISCO_STATE_APPEARING    := 0
OPTIONS_DISCO_STATE_ACTIVE       := 1
OPTIONS_DISCO_STATE_DISAPPEARING := 2

; Note: obviously clobbers the active battlefield. If we
; decide to make this screen available during gameplay, be
; sure to preserve the battlefield state. Generally there is
; no need to preserve anything else; the options battlefield
; is extremely lightweight and will manage the rest of its state.
; We just want the battlefield to apply disco logic for the most part.
.proc options_battlefield_init
MetaSpriteIndex := R0
CurrentWidgetIndex := R20
widget_last_beat := widgets_data0
widget_player_sprite_index := widgets_data1
widget_disco_state := widgets_data2
widget_disco_active_setting := widgets_data3
        perform_zpcm_inc

        ldx CurrentWidgetIndex
        lda #OPTIONS_DISCO_STATE_APPEARING
        sta widget_disco_state, x
        lda current_save + SaveFile::OptionDiscoFloor
        sta widget_disco_active_setting, x

        far_call FAR_find_unused_sprite
        lda MetaSpriteIndex
        ldy CurrentWidgetIndex
        sta widget_player_sprite_index, y

        ldx widget_player_sprite_index, y
        lda #(SPRITE_ACTIVE | SPRITE_PAL_0)
        sta sprite_table + MetaSpriteState::BehaviorFlags, x
        lda #$FF
        sta sprite_table + MetaSpriteState::LifetimeBeats, x
        lda #80
        sta sprite_table + MetaSpriteState::PositionX, x
        lda #64
        sta sprite_table + MetaSpriteState::PositionY, x
        set_ui_00_sprite_x SPRITE_UI_00_PLAYER

        ldx CurrentWidgetIndex
        lda CurrentBeat
        sta widget_last_beat, x

        ldx #0
top_wall_loop:
        perform_zpcm_inc
        lda #TILE_WALL
        sta battlefield, x
        lda #<BG_TILE_MAP_TILES_0231 ; cave wall, lower midsection
        sta tile_patterns, x
        sta tile_detail, x
        lda #((>BG_TILE_MAP_TILES_0231) | PAL_AIR) ; cave wall, lower midsection
        sta tile_attributes, x
        lda #0
        sta tile_flags, x
        sta tile_data, x
        inx
        cpx #16
        bne top_wall_loop

bottom_wall_loop:
        perform_zpcm_inc
        lda #TILE_WALL
        sta battlefield, x
        lda #<BG_TILE_MAP_TILES_0247 ; cave wall, front midsection
        sta tile_patterns, x
        sta tile_detail, x
        lda #((>BG_TILE_MAP_TILES_0247) | PAL_FIRE) ; cave wall, lower midsection
        sta tile_attributes, x
        lda #0
        sta tile_flags, x
        sta tile_data, x
        inx
        cpx #32
        bne bottom_wall_loop

disco_floor_top:
        perform_zpcm_inc
        lda #TILE_DISCO_FLOOR
        sta battlefield, x
        lda #<BG_TILE_DISCO_FLOOR_TILES_0002 ; disco floor with upper dashed lines
        sta tile_patterns, x
        sta tile_detail, x
        lda #((>BG_TILE_DISCO_FLOOR_TILES_0002) | PAL_EARTH) ; cave wall, lower midsection
        sta tile_attributes, x
        lda #0
        sta tile_flags, x
        sta tile_data, x
        inx
        cpx #48
        bne disco_floor_top

disco_floor_mid:
        perform_zpcm_inc
        lda #TILE_DISCO_FLOOR
        sta battlefield, x
        lda #<BG_TILE_DISCO_FLOOR_TILES_0000 ; disco floor, plain
        sta tile_patterns, x
        sta tile_detail, x
        lda #((>BG_TILE_DISCO_FLOOR_TILES_0000) | PAL_EARTH) ; cave wall, lower midsection
        sta tile_attributes, x
        lda #0
        sta tile_flags, x
        sta tile_data, x
        inx
        cpx #80
        bne disco_floor_mid

disco_floor_bottom:
        perform_zpcm_inc
        lda #TILE_DISCO_FLOOR
        sta battlefield, x
        lda #<BG_TILE_DISCO_FLOOR_TILES_0018 ; disco floor with lower dashed lines
        sta tile_patterns, x
        sta tile_detail, x
        lda #((>BG_TILE_DISCO_FLOOR_TILES_0018) | PAL_EARTH) ; cave wall, lower midsection
        sta tile_attributes, x
        lda #0
        sta tile_flags, x
        sta tile_data, x
        inx
        cpx #96
        bne disco_floor_bottom

        ; draw some colored enemies so the battlefield isn't empty
        ; (and we can preview the color thing)
        ; these will still use WALL logic, so they don't actually update

        ldx #(3 * BATTLEFIELD_WIDTH + 2)
        lda #TILE_WALL
        sta battlefield, x
        lda #<BG_TILE_MUSHROOM_IDLE
        sta tile_patterns, x
        lda #(>BG_TILE_MUSHROOM_IDLE | PAL_FIRE)
        sta tile_attributes, x

        ldx #(2 * BATTLEFIELD_WIDTH + 7)
        lda #TILE_WALL
        sta battlefield, x
        lda #<BG_TILE_MUSHROOM_IDLE
        sta tile_patterns, x
        lda #(>BG_TILE_MUSHROOM_IDLE | PAL_ICE)
        sta tile_attributes, x

        perform_zpcm_inc

        ldx #(4 * BATTLEFIELD_WIDTH + 9)
        lda #TILE_WALL
        sta battlefield, x
        lda #<BG_TILE_MUSHROOM_IDLE
        sta tile_patterns, x
        lda #(>BG_TILE_MUSHROOM_IDLE | PAL_AIR)
        sta tile_attributes, x

        ldx #(3 * BATTLEFIELD_WIDTH + 12)
        lda #TILE_WALL
        sta battlefield, x
        lda #<BG_TILE_MUSHROOM_IDLE
        sta tile_patterns, x
        lda #(>BG_TILE_MUSHROOM_IDLE | PAL_EARTH)
        sta tile_attributes, x

        ; finally draw in some bouncy floor mushrooms, to demonstrate the groovement setting
        ldx #(3 * BATTLEFIELD_WIDTH + 4)
        lda #<BG_TILE_DISCO_FLOOR_TILES_0006 ; plain mushroom
        sta tile_patterns, x
        sta tile_detail, x
        ldx #(3 * BATTLEFIELD_WIDTH + 11)
        lda #<BG_TILE_DISCO_FLOOR_TILES_0006 ; plain mushroom
        sta tile_patterns, x
        sta tile_detail, x
        ldx #(4 * BATTLEFIELD_WIDTH + 14)
        lda #<BG_TILE_DISCO_FLOOR_TILES_0006 ; plain mushroom
        sta tile_patterns, x
        sta tile_detail, x

        ldx #(3 * BATTLEFIELD_WIDTH + 8)
        lda #<BG_TILE_DISCO_FLOOR_TILES_0007 ; tall mushroom
        sta tile_patterns, x
        sta tile_detail, x
        ldx #(4 * BATTLEFIELD_WIDTH + 3)
        lda #<BG_TILE_DISCO_FLOOR_TILES_0007 ; tall mushroom
        sta tile_patterns, x
        sta tile_detail, x

        perform_zpcm_inc

        ldy CurrentWidgetIndex
        set_widget_state_y options_battlefield_draw

        perform_zpcm_inc
        rts
.endproc

; todo: if necessary, break this out into several states
; (but ideally we do it all in one go and skip the dual-nametable thing)
.proc options_battlefield_draw
CurrentWidgetIndex := R20
        ; we want to draw to the LEFT battlefield, so we set "active" to
        ; the RIGHT battlefield (we're cheating a bit here)
        lda #1
        sta active_battlefield

        far_call FAR_draw_battlefield_block_A_inline
        far_call FAR_draw_battlefield_block_B_inline
        far_call FAR_draw_battlefield_block_C_inline

        ldy CurrentWidgetIndex
        set_widget_state_y options_battlefield_update

        rts
.endproc

; TODO: if necessary, break this out into several states
.proc options_battlefield_update
StartingRow := R14
StartingTile := R15
CurrentWidgetIndex := R20

widget_last_beat := widgets_data0
widget_player_sprite_index := widgets_data1
widget_disco_state := widgets_data2
widget_disco_active_setting := widgets_data3

        ; check to see if we need to switch sub-states due to a setting change
        ldx CurrentWidgetIndex
        lda current_save + SaveFile::OptionDiscoFloor
        cmp widget_disco_active_setting, x
        beq no_change_needed
        ; if we are currently appearing, we are fine to proceed (this will update the setting)
        lda widget_disco_state, x
        cmp #OPTIONS_DISCO_STATE_APPEARING
        beq no_change_needed
        ; otherwise, flip to the "disappearing" state to force a transition
        lda #OPTIONS_DISCO_STATE_DISAPPEARING
        sta widget_disco_state, x
no_change_needed:

        ; now perform setup for this specific sub-state
        ldx CurrentWidgetIndex
        lda widget_disco_state, x
        cmp #OPTIONS_DISCO_STATE_ACTIVE
        beq disco_tiles_active_state
        cmp #OPTIONS_DISCO_STATE_DISAPPEARING
        beq disco_tiles_disappearing_state
disco_tiles_appearing_state:
        lda current_save + SaveFile::OptionDiscoFloor
        sta widget_disco_active_setting, x
        lda #0
        sta current_clear_status
        lda #1
        sta previous_clear_status
        lda #OPTIONS_DISCO_STATE_ACTIVE
        sta widget_disco_state, x
        jmp converge
disco_tiles_active_state:
        lda #0
        sta current_clear_status
        lda #0
        sta previous_clear_status
        jmp converge
disco_tiles_disappearing_state:
        lda #1
        sta current_clear_status
        lda #0
        sta previous_clear_status
        lda #OPTIONS_DISCO_STATE_APPEARING
        sta widget_disco_state, x
converge:
        
        ; now, preserve the real setting and temporarily load the state-specific one
        lda current_save + SaveFile::OptionDiscoFloor
        pha
        ldx CurrentWidgetIndex
        lda widget_disco_active_setting, x
        sta current_save + SaveFile::OptionDiscoFloor

        lda CurrentBeat
        sta CurrentBeatCounter

        lda #2
        sta StartingRow
        lda #(::BATTLEFIELD_WIDTH * 2)
        sta StartingTile
        far_call FAR_update_static_enemy_row

        lda #3
        sta StartingRow
        lda #(::BATTLEFIELD_WIDTH * 3)
        sta StartingTile
        far_call FAR_update_static_enemy_row

        lda #4
        sta StartingRow
        lda #(::BATTLEFIELD_WIDTH * 4)
        sta StartingTile
        far_call FAR_update_static_enemy_row

        lda #5
        sta StartingRow
        lda #(::BATTLEFIELD_WIDTH * 5)
        sta StartingTile
        far_call FAR_update_static_enemy_row

        ; un-clobber the disco setting that we preserved
        pla
        sta current_save + SaveFile::OptionDiscoFloor

        ; and we... should be set?

        ldy CurrentWidgetIndex
        set_widget_state_y options_battlefield_wait_for_beat

        rts
.endproc

.proc options_battlefield_wait_for_beat
CurrentWidgetIndex := R20
widget_last_beat := widgets_data0
        
        ; while waiting, we can update some other nonessential things
        far_call FAR_apply_player_palette
        lda #1
        sta StagingObjPaletteDirty

        ldx CurrentWidgetIndex
        lda CurrentBeat
        cmp widget_last_beat, x
        bne advance
        rts
advance:
        sta widget_last_beat, x

        ;set_widget_state_y options_battlefield_draw
        ; draw right now!
        jsr options_battlefield_draw

        rts
.endproc

.proc apply_fancy_color_shenanigans
        ; When left/right are pressed, if we are currently on the Preset
        ; field, apply the preset colors to the sliders. If we're currently
        ; on any of the other fields, apply the slider values to the preset instead.
        lda ButtonsDown
        ora ButtonsHeld
        and #(KEY_RIGHT | KEY_LEFT)
        bne perform_shenanigans
        rts

perform_shenanigans:
        ldx #PRESET_FIELD_INDEX
        lda widgets_state_flags, x
        and #WIDGET_STATE_HOVER
        bne preset_is_hovered
        ldx #PALETTE_SLIDER_INDEX_1
        lda widgets_state_flags, x
        and #WIDGET_STATE_HOVER
        bne slider_is_hovered
        ldx #PALETTE_SLIDER_INDEX_2
        lda widgets_state_flags, x
        and #WIDGET_STATE_HOVER
        bne slider_is_hovered
        ldx #PALETTE_SLIDER_INDEX_3
        lda widgets_state_flags, x
        and #WIDGET_STATE_HOVER
        bne slider_is_hovered
        ; nothing is hovered! apply no shenanigans
        rts
        
slider_is_hovered:
        jsr sync_sliders_to_preset
        jsr update_player_color_values
        rts
preset_is_hovered:
        jsr sync_preset_to_sliders
        jsr update_player_color_values
        rts
.endproc

.proc sync_preset_to_sliders
        ; If the preset value is anything other than "Personalized", then
        ; read the preset and apply the colors to the sliders
        ldx current_save + SaveFile::PlayerPalettePreset
        cpx #PRESET_PERSONALIZED_VALUE
        beq change_nothing

        ldy palette_preset_lut_phones, x
        sty current_save + SaveFile::PlayerPalettePhonesIndex
        ldy palette_preset_lut_pajamas, x
        sty current_save + SaveFile::PlayerPalettePajamasIndex
        ldy palette_preset_lut_pigment, x
        sty current_save + SaveFile::PlayerPalettePigmentIndex

change_nothing:
        rts
.endproc

.proc sync_sliders_to_preset
        ; If the sliders don't currently equal the preset value, switch
        ; the preset value to "Personalized"
        ldx current_save + SaveFile::PlayerPalettePreset
        cpx #PRESET_PERSONALIZED_VALUE ; if it's already there, then there's nothing to do
        beq change_nothing

        lda palette_preset_lut_phones, x
        cmp current_save + SaveFile::PlayerPalettePhonesIndex
        bne perform_sync
        lda palette_preset_lut_pajamas, x
        cmp current_save + SaveFile::PlayerPalettePajamasIndex
        bne perform_sync
        lda palette_preset_lut_pigment, x
        cmp current_save + SaveFile::PlayerPalettePigmentIndex
        bne perform_sync
change_nothing:
        rts
perform_sync:
        lda #PRESET_PERSONALIZED_VALUE
        sta current_save + SaveFile::PlayerPalettePreset
        rts
.endproc

.proc update_player_color_values
        ; Read the color index values, work out the PPU values from the global LUT,
        ; and load those colors into the player sprite for preview
        far_call FAR_compute_player_colors

        rts
.endproc