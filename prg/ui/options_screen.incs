; ======================================================================
;                       Screen Specific Logic
; ======================================================================

.segment "CODE_UI_LAYOUTS"

option_palettes_by_tab_index:
        .addr options_pal_tab_palette
        .addr options_pal_tab_palette
        .addr options_pal_tab_gameplay
        .addr options_pal_tab_input
        .addr options_pal_tab_audio
        .addr options_pal_tab_compatibility
        .addr options_pal_tab_debug


; Call this any time the palette data would become stale, usually by
; changing the colorspace option. Or just continually, I guess. It's not
; THAT expensive.
.proc _apply_options_palettes
OptionsHudPalPtr := R0

; Used when setting up palettes
PaletteTablePtr  := R4
PaletteTableBank := R6

; For reading the current tab index
widget_current_tab_index := widgets_data2

        perform_zpcm_inc
        st16 PaletteTablePtr, options_battlefield_palette_table
        st16 PaletteTableBank, .bank(options_battlefield_palette_table)
        far_call FAR_load_palette_by_colorspace
        far_call FAR_set_bg_target_palette_from_hw
        far_call FAR_set_bg_current_palette_from_target

        perform_zpcm_inc
        st16 PaletteTablePtr, options_obj_palette_table
        st16 PaletteTableBank, .bank(options_obj_palette_table)
        far_call FAR_load_palette_by_colorspace
        far_call FAR_set_obj_palette_from_hw

        ; if we're in either of the greyscale modes, apply that hud palette

apply_indexed_hud_palette:
        perform_zpcm_inc
        ldy #OPTIONS_TAB_BAR_INDEX
        lda widget_current_tab_index, y
        asl
        tay
        lda option_palettes_by_tab_index+0, y
        sta OptionsHudPalPtr+0
        lda option_palettes_by_tab_index+1, y
        sta OptionsHudPalPtr+1
        jmp apply_hud_palette_converge
apply_greyscale_hud_palette:
        st16 OptionsHudPalPtr, options_pal_tab_greyscale
apply_hud_palette_converge:
        ldy #0
hud_pal_loop:
        perform_zpcm_inc
        lda (OptionsHudPalPtr), y
        sta IncomingHwPalette, y
        iny
        cpy #16
        bne hud_pal_loop
        far_call FAR_set_hud_bg_palette_from_hw

        lda PlayfieldObjPal0+0
        sta HudObjPal0+0
        lda PlayfieldObjPal0+1
        sta HudObjPal0+1
        lda PlayfieldObjPal0+2
        sta HudObjPal0+2

        perform_zpcm_inc
        rts
.endproc

.proc FAR_options_controller_init
CurrentWidgetIndex := R20

        perform_zpcm_inc
        ; Play the options track on the options screen
        lda #TRACK_OPTIONS
        ldy #TRACK_VARIANT_NORMAL
        jsr play_track

        ; the options screen DOES use extended attributes, so set that up
        lda #0
        sta LeftNametableBank
        sta RightNametableBank
        lda #(NT_FPGA_RAM | NT_EXT_BANK_2 | NT_EXT_BG_AT)
        sta LeftNametableAttr
        sta RightNametableAttr

        ; Initialize with a totally blank nametable
        far_call FAR_draw_blank_nametable

        ; Now we need to zero out the first 4 metatiles, for the pseudo background
        ; to use the correct torchlight (as we aren't actually doing torchlight)
        ; (I guess we could load in a static torchlight pattern if we really wanted to?)
        lda #0
        ldy #0
torchlight_loop_a:
        perform_zpcm_inc
        sta $5800, y
        iny
        bne torchlight_loop_a

        ; we need a fancy mid-frame split to switch from the battlefield preview
        ; to the hud set instead
        set_raster_effect_safely #RASTER_EFFECT_NONE, #RASTER_FINALIZER_OPTIONS, #0
        set_raster_playback_speed #1, #0

        jsr _apply_options_palettes

        lda #BRIGHTNESS_FULLY_DARK
        jsr set_brightness
        lda #BRIGHTNESS_NORMAL
        sta TargetBrightness

        ldy CurrentWidgetIndex
        set_widget_state_y FAR_options_controller_update
        rts
.endproc

.proc FAR_options_controller_update
widget_cursor_nav_index := widgets_data1

        ; We need the playfield to start in CHR 1M mode, to display
        ; the battlefield. We use a raster effect to switch back to
        ; 0M mode using the HUD. This is the only screen that needs this,
        ; which is why we do a simple bodge here.
        lda PlayfieldBgHighBank
        clc
        adc #4
        sta PlayfieldBgHighBank

        lda #KEY_B
        and ButtonsDown
        beq stay_here
        near_call FAR_save_and_return_to_file_details
        rts
stay_here:

        ; Update the separator colors, just like we do during standard gameplay,
        ; but use "off" as the resting state
        lda #$00
        sta HudSeparatorPal+0
        sta HudSeparatorPal+1
        sta HudSeparatorPal+2
        lda #1
        sta StagingHudPaletteDirty
        far_call update_rhythm_assist

        rts
.endproc

.proc FAR_options_page_clear_controller_init
NametableAddr := R0
AttributeAddr := R2
Length := R4

CurrentWidgetIndex := R20
        perform_zpcm_inc
        ; Just clear out everything below the tab bar, back to a blank
        ; slate. Don't overthink this.
        st16 NametableAddr, ($5000 + 32 * 12)
        st16 AttributeAddr, ($5800 + 32 * 12)
        st16 Length, (32 * (30 - 12))

        ldy #0
loop:
        perform_zpcm_inc
        lda #' '
        sta (NametableAddr), y
        lda #CHR_BANK_FONT_MARSHMALLOW
        sta (AttributeAddr), y
        inc16 NametableAddr
        inc16 AttributeAddr
        dec16 Length
        lda Length+0
        ora Length+1
        bne loop

        jsr _apply_options_palettes

        ldy CurrentWidgetIndex
        set_widget_state_y FAR_options_page_clear_controller_update

        perform_zpcm_inc
        rts
.endproc

.proc FAR_options_page_clear_controller_update
        rts
.endproc

.proc FAR_options_color_preview_controller_init
MetaSpriteIndex := R0
CurrentWidgetIndex := R20
widget_color_top_metasprite_index := widgets_data0
widget_color_bottom_metasprite_index := widgets_data1

        ; Allocate two delightful sprites for the color slider area
        far_call FAR_find_unused_sprite
        lda MetaSpriteIndex
        ldy CurrentWidgetIndex
        sta widget_color_top_metasprite_index, y
        ; And set their properties
        ldy CurrentWidgetIndex
        ldx widget_color_top_metasprite_index, y
        lda #(SPRITE_ACTIVE | SPRITE_PAL_0)
        sta sprite_table + MetaSpriteState::BehaviorFlags, x
        lda #$FF
        sta sprite_table + MetaSpriteState::LifetimeBeats, x
        lda #113
        sta sprite_table + MetaSpriteState::PositionX, x
        lda #128
        sta sprite_table + MetaSpriteState::PositionY, x
        set_ui_00_sprite_x SPRITE_UI_00_PLAIN_SQUARES_LEFT

        far_call FAR_find_unused_sprite
        lda MetaSpriteIndex
        ldy CurrentWidgetIndex
        sta widget_color_bottom_metasprite_index, y
        ; And set their properties
        ldy CurrentWidgetIndex
        ldx widget_color_bottom_metasprite_index, y
        lda #(SPRITE_ACTIVE | SPRITE_PAL_0)
        sta sprite_table + MetaSpriteState::BehaviorFlags, x
        lda #$FF
        sta sprite_table + MetaSpriteState::LifetimeBeats, x
        lda #113
        sta sprite_table + MetaSpriteState::PositionX, x
        lda #144
        sta sprite_table + MetaSpriteState::PositionY, x
        set_ui_00_sprite_x SPRITE_UI_00_PLAIN_SQUARES_RIGHT

        ldy CurrentWidgetIndex
        set_widget_state_y FAR_options_color_preview_controller_update

        rts
.endproc

.proc FAR_options_color_preview_controller_update
CurrentWidgetIndex := R20
widget_color_top_metasprite_index := widgets_data0
widget_color_bottom_metasprite_index := widgets_data1
        ; If a cleanup is requested, do that
        ldy CurrentWidgetIndex
        lda widgets_state_flags, y
        and #WIDGET_STATE_CLEANUP_REQUESTED
        bne cleanup_requested
        rts

cleanup_requested:
        ; we need to despawn our metasprite (the player's going to occupy this square, it should vanish)
        ldx CurrentWidgetIndex
        lda widget_color_top_metasprite_index, x
        tay
        lda #0
        sta sprite_table + MetaSpriteState::BehaviorFlags, y

        ldx CurrentWidgetIndex
        lda widget_color_bottom_metasprite_index, x
        tay
        lda #0
        sta sprite_table + MetaSpriteState::BehaviorFlags, y

        ; now switch to the cleanup pending function
        ldy CurrentWidgetIndex
        set_widget_state_y FAR_options_color_preview_controller_wait_for_cleanup
        rts

        rts
.endproc

.proc FAR_options_color_preview_controller_wait_for_cleanup
        rts
.endproc

.proc FAR_save_and_return_to_file_details
        far_call FAR_save_current_file
        far_call FAR_go_to_file_details
        rts
.endproc

OPTIONS_DISCO_STATE_APPEARING    := 0
OPTIONS_DISCO_STATE_ACTIVE       := 1
OPTIONS_DISCO_STATE_DISAPPEARING := 2

; Note: obviously clobbers the active battlefield. If we
; decide to make this screen available during gameplay, be
; sure to preserve the battlefield state. Generally there is
; no need to preserve anything else; the options battlefield
; is extremely lightweight and will manage the rest of its state.
; We just want the battlefield to apply disco logic for the most part.
.proc FAR_options_battlefield_init
MetaSpriteIndex := R0
CurrentWidgetIndex := R20
widget_last_beat := widgets_data0
widget_player_sprite_index := widgets_data1
widget_disco_state := widgets_data2
widget_disco_active_setting := widgets_data3
        perform_zpcm_inc

        ldx CurrentWidgetIndex
        lda #OPTIONS_DISCO_STATE_APPEARING
        sta widget_disco_state, x
        lda current_save + SaveFile::OptionDiscoFloor
        sta widget_disco_active_setting, x

        far_call FAR_find_unused_sprite
        lda MetaSpriteIndex
        ldy CurrentWidgetIndex
        sta widget_player_sprite_index, y

        ldx widget_player_sprite_index, y
        lda #(SPRITE_ACTIVE | SPRITE_PAL_0)
        sta sprite_table + MetaSpriteState::BehaviorFlags, x
        lda #$FF
        sta sprite_table + MetaSpriteState::LifetimeBeats, x
        lda #80
        sta sprite_table + MetaSpriteState::PositionX, x
        lda #32
        sta sprite_table + MetaSpriteState::PositionY, x
        set_ui_00_sprite_x SPRITE_UI_00_PLAYER

        ldx CurrentWidgetIndex
        lda CurrentBeat
        sta widget_last_beat, x

        ldx #0
bottom_wall_loop:
        perform_zpcm_inc
        lda #TILE_WALL
        sta battlefield, x
        lda #<BG_TILE_MAP_TILES_0247 ; cave wall, front midsection
        sta tile_patterns, x
        sta tile_detail, x
        lda #((>BG_TILE_MAP_TILES_0247) | PAL_FIRE) ; cave wall, lower midsection
        sta tile_attributes, x
        lda #0
        sta tile_flags, x
        sta tile_data, x
        inx
        cpx #16
        bne bottom_wall_loop

disco_floor_top:
        perform_zpcm_inc
        lda #TILE_DISCO_FLOOR
        sta battlefield, x
        lda #<BG_TILE_DISCO_FLOOR_TILES_0002 ; disco floor with upper dashed lines
        sta tile_patterns, x
        sta tile_detail, x
        lda #((>BG_TILE_DISCO_FLOOR_TILES_0002) | PAL_EARTH) ; cave wall, lower midsection
        sta tile_attributes, x
        lda #0
        sta tile_flags, x
        sta tile_data, x
        inx
        cpx #32
        bne disco_floor_top

disco_floor_mid:
        perform_zpcm_inc
        lda #TILE_DISCO_FLOOR
        sta battlefield, x
        lda #<BG_TILE_DISCO_FLOOR_TILES_0000 ; disco floor, plain
        sta tile_patterns, x
        sta tile_detail, x
        lda #((>BG_TILE_DISCO_FLOOR_TILES_0000) | PAL_EARTH) ; cave wall, lower midsection
        sta tile_attributes, x
        lda #0
        sta tile_flags, x
        sta tile_data, x
        inx
        cpx #48
        bne disco_floor_mid

disco_floor_bottom:
        perform_zpcm_inc
        lda #TILE_DISCO_FLOOR
        sta battlefield, x
        lda #<BG_TILE_DISCO_FLOOR_TILES_0018 ; disco floor with lower dashed lines
        sta tile_patterns, x
        sta tile_detail, x
        lda #((>BG_TILE_DISCO_FLOOR_TILES_0018) | PAL_EARTH) ; cave wall, lower midsection
        sta tile_attributes, x
        lda #0
        sta tile_flags, x
        sta tile_data, x
        inx
        cpx #64
        bne disco_floor_bottom

        ; draw some colored enemies so the battlefield isn't empty
        ; (and we can preview the color thing)
        ; these will still use WALL logic, so they don't actually update

        ldx #(2 * BATTLEFIELD_WIDTH + 2)
        lda #TILE_WALL
        sta battlefield, x
        lda #<BG_TILE_MUSHROOM_IDLE
        sta tile_patterns, x
        lda #(>BG_TILE_MUSHROOM_IDLE | PAL_FIRE)
        sta tile_attributes, x

        ldx #(1 * BATTLEFIELD_WIDTH + 7)
        lda #TILE_WALL
        sta battlefield, x
        lda #<BG_TILE_MUSHROOM_IDLE
        sta tile_patterns, x
        lda #(>BG_TILE_MUSHROOM_IDLE | PAL_ICE)
        sta tile_attributes, x

        perform_zpcm_inc

        ldx #(3 * BATTLEFIELD_WIDTH + 9)
        lda #TILE_WALL
        sta battlefield, x
        lda #<BG_TILE_MUSHROOM_IDLE
        sta tile_patterns, x
        lda #(>BG_TILE_MUSHROOM_IDLE | PAL_AIR)
        sta tile_attributes, x

        ldx #(2 * BATTLEFIELD_WIDTH + 12)
        lda #TILE_WALL
        sta battlefield, x
        lda #<BG_TILE_MUSHROOM_IDLE
        sta tile_patterns, x
        lda #(>BG_TILE_MUSHROOM_IDLE | PAL_EARTH)
        sta tile_attributes, x

        ; finally draw in some bouncy floor mushrooms, to demonstrate the groovement setting
        ldx #(2 * BATTLEFIELD_WIDTH + 4)
        lda #<BG_TILE_DISCO_FLOOR_TILES_0006 ; plain mushroom
        sta tile_patterns, x
        sta tile_detail, x
        ldx #(2 * BATTLEFIELD_WIDTH + 11)
        lda #<BG_TILE_DISCO_FLOOR_TILES_0006 ; plain mushroom
        sta tile_patterns, x
        sta tile_detail, x

        ldx #(2 * BATTLEFIELD_WIDTH + 8)
        lda #<BG_TILE_DISCO_FLOOR_TILES_0007 ; tall mushroom
        sta tile_patterns, x
        sta tile_detail, x

        perform_zpcm_inc

        ldy CurrentWidgetIndex
        set_widget_state_y FAR_options_battlefield_draw

        perform_zpcm_inc
        rts
.endproc

; todo: if necessary, break this out into several states
; (but ideally we do it all in one go and skip the dual-nametable thing)
.proc FAR_options_battlefield_draw
CurrentWidgetIndex := R20
        ; we want to draw to the LEFT battlefield, so we set "active" to
        ; the RIGHT battlefield (we're cheating a bit here)
        lda #1
        sta active_battlefield

        far_call FAR_draw_battlefield_block_A_inline
        far_call FAR_draw_battlefield_block_B_inline

        ldy CurrentWidgetIndex
        set_widget_state_y FAR_options_battlefield_update

        rts
.endproc

; TODO: if necessary, break this out into several states
.proc FAR_options_battlefield_update
StartingRow := R14
StartingTile := R15
CurrentWidgetIndex := R20

widget_last_beat := widgets_data0
widget_player_sprite_index := widgets_data1
widget_disco_state := widgets_data2
widget_disco_active_setting := widgets_data3

        ; check to see if we need to switch sub-states due to a setting change
        ldx CurrentWidgetIndex
        lda current_save + SaveFile::OptionDiscoFloor
        cmp widget_disco_active_setting, x
        beq no_change_needed
        ; if we are currently appearing, we are fine to proceed (this will update the setting)
        lda widget_disco_state, x
        cmp #OPTIONS_DISCO_STATE_APPEARING
        beq no_change_needed
        ; otherwise, flip to the "disappearing" state to force a transition
        lda #OPTIONS_DISCO_STATE_DISAPPEARING
        sta widget_disco_state, x
no_change_needed:

        ; now perform setup for this specific sub-state
        ldx CurrentWidgetIndex
        lda widget_disco_state, x
        cmp #OPTIONS_DISCO_STATE_ACTIVE
        beq disco_tiles_active_state
        cmp #OPTIONS_DISCO_STATE_DISAPPEARING
        beq disco_tiles_disappearing_state
disco_tiles_appearing_state:
        lda current_save + SaveFile::OptionDiscoFloor
        sta widget_disco_active_setting, x
        lda #0
        sta current_clear_status
        lda #1
        sta previous_clear_status
        lda #OPTIONS_DISCO_STATE_ACTIVE
        sta widget_disco_state, x
        jmp converge
disco_tiles_active_state:
        lda #0
        sta current_clear_status
        lda #0
        sta previous_clear_status
        jmp converge
disco_tiles_disappearing_state:
        lda #1
        sta current_clear_status
        lda #0
        sta previous_clear_status
        lda #OPTIONS_DISCO_STATE_APPEARING
        sta widget_disco_state, x
converge:
        
        ; now, preserve the real setting and temporarily load the state-specific one
        lda current_save + SaveFile::OptionDiscoFloor
        pha
        ldx CurrentWidgetIndex
        lda widget_disco_active_setting, x
        sta current_save + SaveFile::OptionDiscoFloor

        lda CurrentBeat
        sta CurrentBeatCounter

        lda #1
        sta StartingRow
        lda #(::BATTLEFIELD_WIDTH * 1)
        sta StartingTile
        far_call FAR_update_static_enemy_row

        lda #2
        sta StartingRow
        lda #(::BATTLEFIELD_WIDTH * 2)
        sta StartingTile
        far_call FAR_update_static_enemy_row

        lda #3
        sta StartingRow
        lda #(::BATTLEFIELD_WIDTH * 3)
        sta StartingTile
        far_call FAR_update_static_enemy_row

        ; un-clobber the disco setting that we preserved
        pla
        sta current_save + SaveFile::OptionDiscoFloor

        ; and we... should be set?

        ldy CurrentWidgetIndex
        set_widget_state_y FAR_options_battlefield_wait_for_beat

        rts
.endproc

.proc FAR_options_battlefield_wait_for_beat
CurrentWidgetIndex := R20
widget_last_beat := widgets_data0
        
        ; while waiting, we can update some other nonessential things
        far_call FAR_apply_player_palette
        lda #1
        sta StagingObjPaletteDirty

        ldx CurrentWidgetIndex
        lda CurrentBeat
        cmp widget_last_beat, x
        bne advance
        rts
advance:
        sta widget_last_beat, x

        ;set_widget_state_y options_battlefield_draw
        ; draw right now!
        near_call FAR_options_battlefield_draw

        rts
.endproc

.proc FAR_apply_fancy_color_shenanigans
        ; When left/right are pressed, if we are currently on the Preset
        ; field, apply the preset colors to the sliders. If we're currently
        ; on any of the other fields, apply the slider values to the preset instead.
        lda ButtonsDown
        ora ButtonsHeld
        and #(KEY_RIGHT | KEY_LEFT)
        bne perform_shenanigans
        rts

perform_shenanigans:
        ldx #PRESET_FIELD_INDEX
        lda widgets_state_flags, x
        and #WIDGET_STATE_HOVER
        bne preset_is_hovered
        ldx #PALETTE_SLIDER_INDEX_1
        lda widgets_state_flags, x
        and #WIDGET_STATE_HOVER
        bne slider_is_hovered
        ldx #PALETTE_SLIDER_INDEX_2
        lda widgets_state_flags, x
        and #WIDGET_STATE_HOVER
        bne slider_is_hovered
        ldx #PALETTE_SLIDER_INDEX_3
        lda widgets_state_flags, x
        and #WIDGET_STATE_HOVER
        bne slider_is_hovered
        ; nothing is hovered! apply no shenanigans
        rts
        
slider_is_hovered:
        near_call FAR_sync_sliders_to_preset
        near_call FAR_update_player_color_values
        rts
preset_is_hovered:
        near_call FAR_sync_preset_to_sliders
        near_call FAR_update_player_color_values
        rts
.endproc

.proc FAR_sync_preset_to_sliders
        ; If the preset value is anything other than "Personalized", then
        ; read the preset and apply the colors to the sliders
        ldx current_save + SaveFile::PlayerPalettePreset
        cpx #PRESET_PERSONALIZED_VALUE
        beq change_nothing

        ldy palette_preset_lut_phones, x
        sty current_save + SaveFile::PlayerPalettePhonesIndex
        ldy palette_preset_lut_pajamas, x
        sty current_save + SaveFile::PlayerPalettePajamasIndex
        ldy palette_preset_lut_pigment, x
        sty current_save + SaveFile::PlayerPalettePigmentIndex

change_nothing:
        rts
.endproc

.proc FAR_sync_sliders_to_preset
        ; If the sliders don't currently equal the preset value, switch
        ; the preset value to "Personalized"
        ldx current_save + SaveFile::PlayerPalettePreset
        cpx #PRESET_PERSONALIZED_VALUE ; if it's already there, then there's nothing to do
        beq change_nothing

        lda palette_preset_lut_phones, x
        cmp current_save + SaveFile::PlayerPalettePhonesIndex
        bne perform_sync
        lda palette_preset_lut_pajamas, x
        cmp current_save + SaveFile::PlayerPalettePajamasIndex
        bne perform_sync
        lda palette_preset_lut_pigment, x
        cmp current_save + SaveFile::PlayerPalettePigmentIndex
        bne perform_sync
change_nothing:
        rts
perform_sync:
        lda #PRESET_PERSONALIZED_VALUE
        sta current_save + SaveFile::PlayerPalettePreset
        rts
.endproc

.proc FAR_update_player_color_values
        ; Read the color index values, work out the PPU values from the global LUT,
        ; and load those colors into the player sprite for preview
        far_call FAR_compute_player_colors
        ; Also copy these colors into the first hud palette, so that the preview sprite
        ; uses the same set
        lda PlayfieldObjPal0+0
        sta HudObjPal0+0
        lda PlayfieldObjPal0+1
        sta HudObjPal0+1
        lda PlayfieldObjPal0+2
        sta HudObjPal0+2

        rts
.endproc

.proc FAR_apply_colormap_shenanigans
        ; The page where this widget runs is dedicated to screwing around with color, and doesn't
        ; have much else going on. Just continually invalidate all of the palettes, all the time,
        ; so that changes instantly take effect when applied.
        jsr _apply_options_palettes
        far_call FAR_compute_player_colors
        far_call FAR_apply_player_palette

        lda PlayfieldObjPal0+0
        sta HudObjPal0+0
        lda PlayfieldObjPal0+1
        sta HudObjPal0+1
        lda PlayfieldObjPal0+2
        sta HudObjPal0+2

        lda #1
        sta StagingBgPaletteDirty
        sta StagingObjPaletteDirty
        sta StagingHudPaletteDirty

        rts
.endproc

.proc FAR_options_page_refresh_music_controller
        lda current_save + SaveFile::OptionMusicMode
        cmp #OPTION_MUSIC_ENABLED
        beq play_normal_track
        cmp #OPTION_MUSIC_CLICK
        beq play_click_track
        cmp #OPTION_MUSIC_DISABLED
        beq play_silent_track
        ; huh?
        rts
play_normal_track:
        lda #TRACK_OPTIONS
        ldy #TRACK_VARIANT_NORMAL
        jsr play_track
        rts
play_click_track:
        lda #TRACK_OPTIONS_DUP_1
        ldy #TRACK_VARIANT_CLICK
        jsr play_track
        rts
play_silent_track:
        lda #TRACK_OPTIONS_DUP_2
        ldy #TRACK_VARIANT_SILENT
        jsr play_track
        rts
.endproc
