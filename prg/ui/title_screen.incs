; ======================================================================
;                         Layouts and Widgets
; ======================================================================

.segment "DATA_UI_LAYOUTS"

title_ui_layout:
        widget_controller FAR_title_controller_init
        widget_text_button empty_string, FAR_go_to_file_select, 12, 10
        .addr $0000 ; end of list

.segment "DATA_UI_NAMETABLES_0"

title_splash_nametables:

.scope title_splash_flail
        .include "../art/title_splash/splash_flail.asm"
.endscope

.scope title_splash_spear
        .include "../art/title_splash/splash_spear.asm"
.endscope

.segment "CODE_UI_LAYOUTS"

; ======================================================================
;                       Screen Specific Logic
; ======================================================================

SPLASH_VARIANT_FLAIL = 0
SPLASH_VARIANT_SPEAR = 1
SPLASH_VARIANT_SWORD = 2

.proc FAR_display_title_splash
SourceNametable := R0
SourceExAttr := R2
BaseChrPage := R4
NametableAddr := R8
AttributeAddr := R10

CurrentWidgetIndex := R20
widget_selected_splash := widgets_data0
        
        st16 NametableAddr, $5000
        st16 AttributeAddr, $5800

        access_data_bank #<.bank(title_splash_nametables)

        ; Choose the actual banks based on our selected splash
        ldx CurrentWidgetIndex
        lda widget_selected_splash, x
        cmp #SPLASH_VARIANT_FLAIL
        beq setup_flail
        cmp #SPLASH_VARIANT_SPEAR
        beq setup_spear
        ; shouldn't be reachable?

setup_sword:
        ; Not here yet, but will be our default case
        ; jmp perform_oam_copy
setup_flail:
        st16 SourceNametable, title_splash_flail::nametable
        st16 SourceExAttr, title_splash_flail::exattr
        lda #CHR_BANK_SPLASH_FLAIL_BG
        sta BaseChrPage
        jmp perform_copy
setup_spear:
        st16 SourceNametable, title_splash_spear::nametable
        st16 SourceExAttr, title_splash_spear::exattr
        lda #CHR_BANK_SPLASH_SPEAR_BG
        sta BaseChrPage
        jmp perform_copy

perform_copy:
        ; Copy in the nametable, accounting for the base bank where the tiles live
        ldx #4 ; use this as a page counter
        ldy #0
loop:
        lda (SourceNametable), y
        sta (NametableAddr), y
        lda (SourceExAttr), y
        clc
        adc BaseChrPage
        sta (AttributeAddr), y
        iny
        bne loop
        inc SourceNametable+1
        inc SourceExAttr+1
        inc NametableAddr+1
        inc AttributeAddr+1
        dex
        bne loop

        restore_previous_bank

        rts
.endproc

.proc FAR_setup_title_palettes
CurrentWidgetIndex := R20
widget_selected_splash := widgets_data0
        ; Get the palette data hooked up. For now, assume the flail layout and no split.
        ; Later this needs to become a HUD split, and we'll need to do something about the
        ; title area up top.
        lda #$00
        sta TargetPlayfieldBackdrop

        lda player_palettes_pajamas+PLAYER_PALETTE_TITLE_BASE
        sec
        sbc #$20
        sta TargetPlayfieldBgPal0+0
        sta PlayfieldObjPal0+0
        lda player_palettes_pajamas+PLAYER_PALETTE_TITLE_BASE
        sec
        sbc #$10
        sta TargetPlayfieldBgPal0+1
        sta PlayfieldObjPal0+1
        lda player_palettes_pajamas+PLAYER_PALETTE_TITLE_BASE
        sta TargetPlayfieldBgPal0+2
        sta PlayfieldObjPal0+2

        lda player_palettes_phones+PLAYER_PALETTE_TITLE_BASE
        sec
        sbc #$10
        sta TargetPlayfieldBgPal1+0
        sta PlayfieldObjPal1+0
        lda player_palettes_phones+PLAYER_PALETTE_TITLE_BASE
        sta TargetPlayfieldBgPal1+1
        sta PlayfieldObjPal1+1

        ; Spear only needs white here, all others use phones+1
        ldx CurrentWidgetIndex
        lda widget_selected_splash, x
        cmp #SPLASH_VARIANT_SPEAR
        beq use_spear_phones_color
use_sword_flail_phones_color:
        lda player_palettes_phones+PLAYER_PALETTE_TITLE_BASE
        clc
        adc #$10
        sta TargetPlayfieldBgPal1+2
        sta PlayfieldObjPal1+2
        jmp done_picking_phones_color
use_spear_phones_color:
        lda #$50
        sta TargetPlayfieldBgPal1+2
        sta PlayfieldObjPal1+2
done_picking_phones_color:

        lda player_palettes_pigment+PLAYER_PALETTE_TITLE_BASE
        sec
        sbc #$10
        sta TargetPlayfieldBgPal2+0
        sta PlayfieldObjPal2+0
        lda player_palettes_pigment+PLAYER_PALETTE_TITLE_BASE
        sta TargetPlayfieldBgPal2+1
        sta PlayfieldObjPal2+1
        lda #$50
        sta TargetPlayfieldBgPal2+2
        sta PlayfieldObjPal2+2

        lda #$20
        sta TargetPlayfieldBgPal3+0
        sta PlayfieldObjPal3+0
        lda #$30
        sta TargetPlayfieldBgPal3+1
        sta PlayfieldObjPal3+1
        lda #$50
        sta TargetPlayfieldBgPal3+2
        sta PlayfieldObjPal3+2

        far_call FAR_set_bg_current_palette_from_target

        rts
.endproc

.proc FAR_draw_title_sprites
OamPtr    := R0
SourceOam := R2
OamIndex := R4

CurrentWidgetIndex := R20
widget_selected_splash := widgets_data0

        access_data_bank #<.bank(title_splash_nametables)

        ; For now, initialize the flail every time.
        ; TODO: once we have the other splash screens converted, pick one
        ; at random. (depending on how fancy we intend to be, gate some
        ; of the choices based on whether the player has that weapon?)

        ; Choose the actual banks based on our selected splash
        ldx CurrentWidgetIndex
        lda widget_selected_splash, x
        cmp #SPLASH_VARIANT_FLAIL
        beq setup_flail
        cmp #SPLASH_VARIANT_SPEAR
        beq setup_spear
        ; shouldn't be reachable?

setup_sword:
        ; Not here yet, but will be our default case
        ; jmp perform_oam_copy
setup_flail:
        st16 SourceOam, title_splash_flail::oam
        jmp perform_oam_copy
setup_spear:
        st16 SourceOam, title_splash_spear::oam
        jmp perform_oam_copy


perform_oam_copy:
        lda #0
        sta OamIndex
loop:
        ldx OamIndex
        lda sprite_ptr_lut_low, x
        sta OamPtr+0
        lda sprite_ptr_lut_high, x
        sta OamPtr+1
        ldy #0
        lda (SourceOam), y
        ldy #SelfModifiedSprite::PosY
        sta (OamPtr), y
        ldy #1
        lda (SourceOam), y
        ldy #SelfModifiedSprite::TileId
        sta (OamPtr), y
        ldy #2
        lda (SourceOam), y
        ldy #SelfModifiedSprite::Attributes
        sta (OamPtr), y
        ldy #3
        lda (SourceOam), y
        ldy #SelfModifiedSprite::PosX
        sta (OamPtr), y
        add16b SourceOam, #4
        inc OamIndex
        lda OamIndex
        cmp #64
        bne loop

        restore_previous_bank

        rts
.endproc

.proc FAR_fix_obj_chr_bank
CurrentWidgetIndex := R20
widget_selected_splash := widgets_data0

        ; We are setting these banks very manually, so switch these ORA variables
        ; to 0, which will effectively NOP them when run later.
        lda #0
        sta PlayerObjHighBank
        sta PlayfieldBgObjHighBank
        sta HudObjHighBank

        ; Choose the actual banks based on our selected splash
        ldx CurrentWidgetIndex
        lda widget_selected_splash, x
        cmp #SPLASH_VARIANT_FLAIL
        beq setup_flail
        cmp #SPLASH_VARIANT_SPEAR
        beq setup_spear
        ; shouldn't be reachable?

setup_sword:
        ; Not here yet, but will be our default case

setup_flail:
        lda #<(CHR_BANK_SPLASH_FLAIL_OBJ >> 5)
        jsr set_hi_chr_bank
        .repeat 8, i
        lda #<((CHR_BANK_SPLASH_FLAIL_OBJ << 3) + i)
        sta PlayfieldObjBanks+i
        sta HudObjBanks+i
        .endrepeat
        rts

setup_spear:
        lda #<(CHR_BANK_SPLASH_SPEAR_OBJ >> 5)
        jsr set_hi_chr_bank
        .repeat 8, i
        lda #<((CHR_BANK_SPLASH_SPEAR_OBJ << 3) + i)
        sta PlayfieldObjBanks+i
        sta HudObjBanks+i
        .endrepeat

        

        rts
.endproc

title_splash_lut:
        .repeat 8
        .byte SPLASH_VARIANT_FLAIL
        .endrepeat
        .repeat 8
        .byte SPLASH_VARIANT_SPEAR
        .endrepeat

.proc FAR_title_controller_init
CurrentWidgetIndex := R20
widget_selected_splash := widgets_data0

        jsr next_global_rand
        and #$0F
        tax
        lda title_splash_lut, x
        ldx CurrentWidgetIndex
        sta widget_selected_splash, x
        
        ; The titlescreen does use extended nametables now, so get those going
        lda #0
        sta LeftNametableBank
        sta RightNametableBank
        lda #(NT_FPGA_RAM | NT_EXT_BANK_2 | NT_EXT_BG_AT)
        sta LeftNametableAttr
        sta RightNametableAttr

        ; The title screen alone uses 8x8 mode, set that up here
        lda #(VBLANK_NMI | BG_1000 | OBJ_0000 | NT_2000)
        sta DesiredPpuCtrl

        far_call FAR_compute_player_colors
        near_call FAR_display_title_splash
        near_call FAR_setup_title_palettes
        near_call FAR_draw_title_sprites
        near_call FAR_fix_obj_chr_bank

        ; Play the title track on the title screen
        lda #TRACK_TITLE
        ldy #TRACK_VARIANT_NORMAL
        jsr play_track

        ; NOW we may safely begin to fade in
        lda #BRIGHTNESS_FULLY_DARK
        jsr set_brightness
        lda #BRIGHTNESS_NORMAL
        sta TargetBrightness

        ldy CurrentWidgetIndex
        set_widget_state_y FAR_title_controller_update
        rts
.endproc

.proc FAR_title_controller_update
CurrentWidgetIndex := R20
        ; This is after beat counters were done, so fix all the banks
        ; and clear that out. Title screen sprites do not animate!
        near_call FAR_fix_obj_chr_bank

        ; while on the title screen, continuously clock the rng seeds. this helps
        ; with entropy when starting a brand new game, even in emulators with an
        ; otherwise deterministic boot state
        jsr next_global_rand
        jsr next_gameplay_rand

        lda #(KEY_START | KEY_A)
        and ButtonsDown
        beq stay_here
        far_call FAR_go_to_file_select

stay_here:
        rts
.endproc
