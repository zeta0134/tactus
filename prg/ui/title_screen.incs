; ======================================================================
;                         Layouts and Widgets
; ======================================================================

.segment "DATA_UI_LAYOUTS"

title_ui_layout:
        widget_controller FAR_title_controller_init
        .addr $0000 ; end of list

.segment "DATA_UI_NAMETABLES_0"

title_splash_nametables:

.scope title_splash_flail
        .include "../art/title_splash/splash_flail.asm"
.endscope

.scope title_splash_spear
        .include "../art/title_splash/splash_spear.asm"
.endscope

.scope title_splash_sword
        .include "../art/title_splash/splash_sword.asm"
.endscope

title_text_nametable:
        .incbin "../art/raw_nametables/title_text.nam"

.segment "CODE_UI_LAYOUTS"

; ======================================================================
;                       Screen Specific Logic
; ======================================================================

SPLASH_VARIANT_FLAIL = 0
SPLASH_VARIANT_SPEAR = 1
SPLASH_VARIANT_SWORD = 2

.proc FAR_display_title_splash
SourceNametable := R0
SourceExAttr := R2
BaseChrPage := R4
NametableAddr := R8
AttributeAddr := R10

CurrentWidgetIndex := R20
widget_selected_splash := widgets_data0
        
        st16 NametableAddr, $5000
        st16 AttributeAddr, $5800

        access_data_bank #<.bank(title_splash_nametables)

        ; Choose the actual banks based on our selected splash
        ldx CurrentWidgetIndex
        lda widget_selected_splash, x
        cmp #SPLASH_VARIANT_FLAIL
        beq setup_flail
        cmp #SPLASH_VARIANT_SPEAR
        beq setup_spear
        ; default to sword

setup_sword:
        st16 SourceNametable, title_splash_sword::nametable
        st16 SourceExAttr, title_splash_sword::exattr
        lda #CHR_BANK_SPLASH_SWORD_BG
        sta BaseChrPage
        jmp perform_copy
setup_flail:
        st16 SourceNametable, title_splash_flail::nametable
        st16 SourceExAttr, title_splash_flail::exattr
        lda #CHR_BANK_SPLASH_FLAIL_BG
        sta BaseChrPage
        jmp perform_copy
setup_spear:
        st16 SourceNametable, title_splash_spear::nametable
        st16 SourceExAttr, title_splash_spear::exattr
        lda #CHR_BANK_SPLASH_SPEAR_BG
        sta BaseChrPage
        jmp perform_copy

perform_copy:
        ; Copy in the nametable, accounting for the base bank where the tiles live
        ldx #4 ; use this as a page counter
        ldy #0
loop:
        lda (SourceNametable), y
        sta (NametableAddr), y
        lda (SourceExAttr), y
        clc
        adc BaseChrPage
        sta (AttributeAddr), y
        iny
        bne loop
        inc SourceNametable+1
        inc SourceExAttr+1
        inc NametableAddr+1
        inc AttributeAddr+1
        dex
        bne loop

        restore_previous_bank

        rts
.endproc

; TODO: will this be localized? If so, we may need to load a different
; nametable here.
.proc FAR_display_title_text
SourceNametable := R0
NametableAddr := R2
AttributeAddr := R4
Length := R6
        st16 SourceNametable, title_text_nametable
        st16 NametableAddr, $5000
        st16 AttributeAddr, $5800
        st16 Length, (32*12)

        access_data_bank #<.bank(title_splash_nametables)

perform_copy:
        ldy #0
loop:
        lda (SourceNametable), y
        sta (NametableAddr), y
        lda #0
        sta (AttributeAddr), y
        
        inc16 SourceNametable
        inc16 NametableAddr
        inc16 AttributeAddr
        dec16 Length
        lda Length+0
        ora Length+1
        bne loop

        restore_previous_bank

        rts
.endproc

.proc FAR_setup_title_palettes
CurrentWidgetIndex := R20
widget_selected_splash := widgets_data0
        ; Both palette sections use the same backdrop color of solid black
        lda #$00
        sta TargetPlayfieldBackdrop
        sta HudBackdrop

        lda player_palettes_pajamas+PLAYER_PALETTE_TITLE_BASE
        sec
        sbc #$20
        sta HudBgPal0+0
        sta HudObjPal0+0
        sta PlayfieldObjPal0+0
        lda player_palettes_pajamas+PLAYER_PALETTE_TITLE_BASE
        sec
        sbc #$10
        sta HudBgPal0+1
        sta HudObjPal0+1
        sta PlayfieldObjPal0+1
        lda player_palettes_pajamas+PLAYER_PALETTE_TITLE_BASE
        sta HudBgPal0+2
        sta HudObjPal0+2
        sta PlayfieldObjPal0+2

        lda player_palettes_phones+PLAYER_PALETTE_TITLE_BASE
        sec
        sbc #$10
        sta HudBgPal1+0
        sta PlayfieldObjPal1+0
        lda player_palettes_phones+PLAYER_PALETTE_TITLE_BASE
        sta HudBgPal1+1
        sta PlayfieldObjPal1+1

        ; Spear only needs white here, all others use phones+1
        ldx CurrentWidgetIndex
        lda widget_selected_splash, x
        cmp #SPLASH_VARIANT_SPEAR
        beq use_spear_phones_color
use_sword_flail_phones_color:
        lda player_palettes_phones+PLAYER_PALETTE_TITLE_BASE
        clc
        adc #$10
        sta HudBgPal1+2
        sta PlayfieldObjPal1+2
        jmp done_picking_phones_color
use_spear_phones_color:
        lda #$50
        sta HudBgPal1+2
        sta PlayfieldObjPal1+2
done_picking_phones_color:

        lda player_palettes_pigment+PLAYER_PALETTE_TITLE_BASE
        sec
        sbc #$10
        sta HudBgPal2+0
        sta PlayfieldObjPal2+0
        lda player_palettes_pigment+PLAYER_PALETTE_TITLE_BASE
        sta HudBgPal2+1
        sta PlayfieldObjPal2+1
        lda #$50
        sta HudBgPal2+2
        sta PlayfieldObjPal2+2

        lda #$20
        sta HudBgPal3+0
        sta PlayfieldObjPal3+0
        lda #$30
        sta HudBgPal3+1
        sta PlayfieldObjPal3+1
        lda #$50
        sta HudBgPal3+2
        sta PlayfieldObjPal3+2

        ; The sword only uses a funny palette for one of the bg layers,
        ; apply that here if necessary
        ldx CurrentWidgetIndex
        lda widget_selected_splash, x
        cmp #SPLASH_VARIANT_SWORD
        bne done_with_sword_variant
        lda player_palettes_phones+PLAYER_PALETTE_TITLE_BASE
        sta HudBgPal2+0
        lda player_palettes_phones+PLAYER_PALETTE_TITLE_BASE
        clc
        adc #$10
        sta HudBgPal2+1
        lda #$20
        sta HudBgPal2+2
done_with_sword_variant:

        ; The "playfield" background controls the text palette, and for now
        ; we'll use a fixed sortof aqua green for the text:
        lda #$1C
        sta TargetPlayfieldBgPal0+0
        lda #$2B
        sta TargetPlayfieldBgPal0+1
        lda #$3A
        sta TargetPlayfieldBgPal0+2
        ; We aren't using the rest, so clear those all out to nothing
        lda #$00
        sta TargetPlayfieldBgPal1+0
        sta TargetPlayfieldBgPal1+1
        sta TargetPlayfieldBgPal1+2
        sta TargetPlayfieldBgPal2+0
        sta TargetPlayfieldBgPal2+1
        sta TargetPlayfieldBgPal2+2
        sta TargetPlayfieldBgPal3+0
        sta TargetPlayfieldBgPal3+1
        sta TargetPlayfieldBgPal3+2

        far_call FAR_set_bg_current_palette_from_target

        rts
.endproc

.proc FAR_draw_title_sprites
OamPtr    := R0
SourceOam := R2
OamIndex := R4

CurrentWidgetIndex := R20
widget_selected_splash := widgets_data0

        access_data_bank #<.bank(title_splash_nametables)

        ; For now, initialize the flail every time.
        ; TODO: once we have the other splash screens converted, pick one
        ; at random. (depending on how fancy we intend to be, gate some
        ; of the choices based on whether the player has that weapon?)

        ; Choose the actual banks based on our selected splash
        ldx CurrentWidgetIndex
        lda widget_selected_splash, x
        cmp #SPLASH_VARIANT_FLAIL
        beq setup_flail
        cmp #SPLASH_VARIANT_SPEAR
        beq setup_spear
        ; default to sword
setup_sword:
        st16 SourceOam, title_splash_sword::oam
        jmp perform_oam_copy
setup_flail:
        st16 SourceOam, title_splash_flail::oam
        jmp perform_oam_copy
setup_spear:
        st16 SourceOam, title_splash_spear::oam
        jmp perform_oam_copy


perform_oam_copy:
        lda #0
        sta OamIndex
loop:
        ldx OamIndex
        lda sprite_ptr_lut_low, x
        sta OamPtr+0
        lda sprite_ptr_lut_high, x
        sta OamPtr+1
        ldy #0
        lda (SourceOam), y
        ldy #SelfModifiedSprite::PosY
        sta (OamPtr), y
        ldy #1
        lda (SourceOam), y
        ldy #SelfModifiedSprite::TileId
        sta (OamPtr), y
        ldy #2
        lda (SourceOam), y
        ldy #SelfModifiedSprite::Attributes
        sta (OamPtr), y
        ldy #3
        lda (SourceOam), y
        ldy #SelfModifiedSprite::PosX
        sta (OamPtr), y
        add16b SourceOam, #4
        inc OamIndex
        lda OamIndex
        cmp #64
        bne loop

        restore_previous_bank

        rts
.endproc

.proc FAR_fix_obj_chr_bank
CurrentWidgetIndex := R20
widget_selected_splash := widgets_data0
widget_temp_timer      := widgets_data1
widget_temp_frame      := widgets_data2

        ; We are setting these banks very manually, so switch these ORA variables
        ; to 0, which will effectively NOP them when run later.
        lda #0
        sta PlayerObjHighBank
        sta PlayfieldBgObjHighBank
        sta HudObjHighBank

        lda #0
        jsr set_hi_chr_bank

        ; Choose the actual banks based on our selected splash
        ldx CurrentWidgetIndex
        lda widget_selected_splash, x
        cmp #SPLASH_VARIANT_FLAIL
        beq setup_flail
        cmp #SPLASH_VARIANT_SPEAR
        jeq setup_spear
        ; default to sword

setup_sword:
        lda #STATIC_CHR_BANK_SPLASH_SWORD_OBJ
        sta HudObjBanks+0
        jmp done_with_obj

setup_flail:
        lda #STATIC_CHR_BANK_SPLASH_FLAIL_OBJ
        sta HudObjBanks+0
        jmp done_with_obj

setup_spear:
        lda #STATIC_CHR_BANK_SPLASH_SPEAR_OBJ
        sta HudObjBanks+0
        ; fall through to done_with_obj
done_with_obj:

        ; Now for the title screen, set an initial frame. We'll be switching
        ; this out with a raster effect later so don't overthink this
        ldx CurrentWidgetIndex
        lda #STATIC_CHR_BANK_TITLE_0000
        clc
        adc widget_temp_frame, x
        sta PlayfieldObjBanks+1

        ; And update the temporary timer
        lda widget_temp_timer, x
        beq advance_frame
        dec widget_temp_timer, x
        rts
advance_frame:
        lda #4
        sta widget_temp_timer, x
        lda widget_temp_frame, x
        clc
        adc #1
        and #$0F
        sta widget_temp_frame, x
        rts
.endproc

title_splash_lut:
        ; Force one for testing
        ;.repeat 16
        ;.byte SPLASH_VARIANT_SWORD
        ;.endrepeat

        ; The actual distribution
        .repeat 8
        .byte SPLASH_VARIANT_SWORD
        .endrepeat
        .repeat 4
        .byte SPLASH_VARIANT_FLAIL
        .endrepeat
        .repeat 4
        .byte SPLASH_VARIANT_SPEAR
        .endrepeat

.proc FAR_title_controller_init
CurrentWidgetIndex := R20
widget_selected_splash := widgets_data0
widget_temp_timer      := widgets_data1
widget_temp_frame      := widgets_data2

        jsr next_global_rand
        and #$0F
        tax
        lda title_splash_lut, x
        ldx CurrentWidgetIndex
        sta widget_selected_splash, x

        lda #0
        sta widget_temp_timer, x
        sta widget_temp_frame, x
        
        ; The titlescreen alone uses 4k CHR banking, which has lots of irritating implications.
        ; Get those set up now
        lda #(CHR_CHIP_ROM | CHR_MODE_1)
        sta MAP_CHR_CONTROL

        ; The titlescreen text uses extended attributes, but not extended banks
        lda #0
        sta LeftNametableBank
        sta RightNametableBank
        lda #(NT_FPGA_RAM | NT_EXT_BANK_2 | NT_EXT_AT)
        sta LeftNametableAttr
        sta RightNametableAttr

        ; Note that the palette swap will turn extended attributes back on once we're done with the titlescreen
        ; bit, after which only sprites will be using the CHR banks.

        set_raster_effect_safely #RASTER_EFFECT_NONE, #RASTER_FINALIZER_TITLE, #0
        set_raster_playback_speed #1, #0

        ; The title screen alone uses 8x8 mode, set that up here
        lda #(VBLANK_NMI | BG_1000 | OBJ_0000 | NT_2000)
        sta DesiredPpuCtrl

        far_call FAR_compute_player_colors
        near_call FAR_display_title_splash
        near_call FAR_display_title_text
        near_call FAR_setup_title_palettes
        near_call FAR_draw_title_sprites
        near_call FAR_fix_obj_chr_bank

        ; Play the title track on the title screen
        lda #TRACK_TITLE
        ldy #TRACK_VARIANT_NORMAL
        jsr play_track

        ; NOW we may safely begin to fade in
        lda #BRIGHTNESS_FULLY_DARK
        jsr set_brightness
        lda #BRIGHTNESS_NORMAL
        sta TargetBrightness
        lda #FADE_SPEED_UI
        sta GlobalFadeSpeed

        ldy CurrentWidgetIndex
        set_widget_state_y FAR_title_controller_update
        rts
.endproc

.proc FAR_title_controller_update
CurrentWidgetIndex := R20
        ; This is after beat counters were done, so fix all the banks
        ; and clear that out. Title screen sprites do not animate!
        near_call FAR_fix_obj_chr_bank

        ; while on the title screen, continuously clock the rng seeds. this helps
        ; with entropy when starting a brand new game, even in emulators with an
        ; otherwise deterministic boot state
        jsr next_global_rand
        jsr next_gameplay_rand

        lda #(KEY_START | KEY_A)
        and ButtonsDown
        beq stay_here
        far_call FAR_go_to_file_select

stay_here:
        rts
.endproc
